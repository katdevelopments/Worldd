	local pages = tutorialPages
	local currentPage = 1
	local renderedPage = nil

	-- Forward declarations so the handlers can reference each other.
	local updatePage, closeTutorial, advance, back

	function advance()
		if tutorialState.closing then
			return
		end
		if currentPage < #pages then
			currentPage += 1
			updatePage()
		else
			closeTutorial(true)
		end
	end

	function back()
		if tutorialState.closing or currentPage <= 1 then
			return
		end
		currentPage -= 1
		updatePage()
	end

	function updatePage()
		if not card.Parent then
			return
		end
		local pageData = pages[currentPage]

		if pageData.DynamicTitle then
			tutTitle.Text = tr("Welcome") .. ", " .. player.DisplayName .. "!"
		else
			tutTitle.Text = tr(pageData.Title)
		end
		tutBody.Text = tr(pageData.Text)
		tutIcon.Text = pageData.Icon or ""
		skipButton.Text = tr("Skip")

		introPanel.Visible = pageData.Kind == "intro"
		if introPanel.Visible then
			langSearch.PlaceholderText = "🔎 " .. tr("Search language...")
			discordButtonTour.Text = "💬  " .. tr("Join our Discord")
		end

		counter.Text = currentPage .. " / " .. #pages
		-- updatePage also runs on every localisation refresh, so only animate the
		-- bar when the page actually moved; otherwise snap it.
		local fillSize = UDim2.new(currentPage / #pages, 0, 1, 0)
		if renderedPage == currentPage then
			progressFill.Size = fillSize
		else
			renderedPage = currentPage
			TweenService:Create(progressFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = fillSize,
			}):Play()
		end

		prevButton.Visible = currentPage > 1
		skipButton.Visible = (currentPage ~= #pages)
		nextButton.Text = (currentPage == #pages) and "✅" or "➡️"
		syncTitleWidth()
	end

	function closeTutorial(completed)
		if tutorialState.closing or not card.Parent then
			return
		end
		tutorialState.closing = true
		tutorialState.restyle = nil
		tutorialState.refresh = nil

		for _, conn in ipairs(tourConnections) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		table.clear(tourConnections)

		-- createIconButton registers every button it makes for theme updates;
		-- drop the two this tour owns so the list doesn't grow on each replay.
		for _, btn in ipairs({ prevButton, nextButton }) do
			local at = table.find(utilButtons, btn)
			if at then
				table.remove(utilButtons, at)
			end
		end

		if not tutorialCompleted then
			tutorialCompleted = true
			saveSettings()
		end
		if not completed and log then
			log(tr("Tutorial skipped. Reopen it any time from Settings > Replay Tutorial."), "Info")
		end

		if dimOverlay.Parent then
			TweenService:Create(dimOverlay, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.delay(0.3, function()
				if dimOverlay.Parent then
					dimOverlay:Destroy()
				end
			end)
		end
		local tween =
			TweenService:Create(cardScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 })
		tween:Play()
		tween.Completed:Wait()
		if card.Parent then
			card:Destroy()
		end
		-- Cleared only once the card is really gone, so a `tutorial()` call
		-- during the fade can't stack a second tour on top of this one.
		tutorialState.active = false
		tutorialState.closing = false
	end

	-- Swipe left/right anywhere on the tour to page through it, and tap the
	-- dimmed backdrop to advance. Both were dead space before.
	local function attachGestures(target, tapAdvances, blocked)
		-- Track the exact InputObject that started the gesture so a second finger
		-- (or the mouse) can't close a swipe that a different pointer opened.
		local startX, startInput = nil, nil
		track(target.InputBegan:Connect(function(input)
			if blocked and blocked() then
				return
			end
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				startX = input.Position.X
				startInput = input
			end
		end))
		track(target.InputEnded:Connect(function(input)
			if startInput == nil or input ~= startInput then
				return
			end
			local delta = input.Position.X - startX
			startX, startInput = nil, nil
			if delta <= -40 then
				advance()
			elseif delta >= 40 then
				back()
			elseif tapAdvances and math.abs(delta) < 12 then
				advance()
			end
		end))
	end
	attachGestures(dimOverlay, true)
	-- Swiping the card is disabled on the intro page: a drag there belongs to the
	-- language list, not to paging.
	attachGestures(card, false, function()
		return introPanel.Visible
	end)

	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not card.Parent then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Escape then
			closeTutorial(currentPage == #pages)
		elseif
			key == Enum.KeyCode.Return
			or key == Enum.KeyCode.KeypadEnter
			or key == Enum.KeyCode.Space
			or key == Enum.KeyCode.Right
			or key == Enum.KeyCode.Down
		then
			advance()
		elseif key == Enum.KeyCode.Left or key == Enum.KeyCode.Up then
			back()
		end
	end))

	track(prevButton.MouseButton1Click:Connect(back))
	track(nextButton.MouseButton1Click:Connect(advance))
	track(skipButton.MouseButton1Click:Connect(function()
		closeTutorial(false)
	end))

	-- Re-render on a language switch and re-tint on a theme/font switch while
	-- the card is on screen; both used to leave the tour stale.
	tutorialState.refresh = function()
		updatePage()
	end
	tutorialState.restyle = function(theme, fontData)
		if not card.Parent then
			return
		end
		tintTween(card, { BackgroundColor3 = theme.Background })
		tintTween(cardStroke, { Color = theme.PrimaryAccent })
		tintTween(tutTitle, { TextColor3 = theme.Text })
		tintTween(tutIcon, { TextColor3 = theme.Text })
		tintTween(tutBody, { TextColor3 = theme.Text })
		tintTween(counter, { TextColor3 = theme.SecondaryAccent })
		tintTween(skipButton, { TextColor3 = theme.InputEcho })
		tintTween(progressTrack, { BackgroundColor3 = theme.UtilButton })
		tintTween(progressFill, { BackgroundColor3 = theme.SecondaryAccent })
		tintTween(langSearch, { BackgroundColor3 = theme.UtilButton, TextColor3 = theme.Text })
		tintTween(langScroll, { BackgroundColor3 = theme.UtilButton, ScrollBarImageColor3 = theme.PrimaryAccent })
		tintTween(discordButtonTour, { BackgroundColor3 = theme.SecondaryAccent })
		langSearch.PlaceholderColor3 = theme.InputEcho
		tutTitle.Font = fontData.Bold
		tutBody.Font = fontData.Font
		counter.Font = fontData.Font
		skipButton.Font = fontData.Font
		langSearch.Font = fontData.Font
		discordButtonTour.Font = fontData.Bold
		prevButton.Font = fontData.Bold
		nextButton.Font = fontData.Bold

		local newBase = CONFIG.TextSize
		tutTitle.TextSize = newBase + 5
		tutIcon.TextSize = newBase + 6
		tutBody.TextSize = newBase + 1
		counter.TextSize = newBase
		skipButton.TextSize = newBase
		langSearch.TextSize = newBase
		discordButtonTour.TextSize = newBase
		headerRow.Size = UDim2.new(1, 0, 0, math.max(30, newBase + 16))

		for _, row in pairs(langRows) do
			row.TextSize = newBase
			row.BackgroundColor3 = theme.PrimaryAccent
		end
		syncLangSelection(theme, fontData)
	end

	TweenService:Create(cardScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	createClickParticles(card, CONFIG.Colors.PrimaryAccent)
	updatePage()
end

