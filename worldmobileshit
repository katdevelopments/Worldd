				if openAutoExec then
					aeOverlay.Visible = false
					aeFrame.Visible = false
				end
				log("Loaded '" .. item.Name .. "' into a new editor tab.", "Info")
			end)

			delBtn.MouseButton1Click:Connect(function()
				table.remove(autoExecScripts, index)
				saveAutoExecFile()
				refreshAeList()
			end)
		end
	end

	local aeIsOpen = false
	local function closeAe()
		aeIsOpen = false
		aeOverlay.Visible = false
		local tw = TweenService:Create(
			aeScale,
			TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In),
			{ Scale = 0 }
		)
		tw:Play()
		tw.Completed:Once(function()
			aeFrame.Visible = false
		end)
	end

	function openAutoExec()
		if settingsFrame.Visible then
			toggleSettings()
		end
		
		-- Auto-detect open tabs and add to AE list if not present
		local existing = {}
		for _, v in ipairs(autoExecScripts) do
			existing[v.Name] = v
		end
		local updated = false
		for _, tab in ipairs(editorTabs) do
			if tab.name and tab.name ~= "" and not existing[tab.name] then
				table.insert(autoExecScripts, { Name = tab.name, Source = tab.content, Enabled = false })
				existing[tab.name] = autoExecScripts[#autoExecScripts]
				updated = true
			elseif tab.name and tab.name ~= "" and existing[tab.name] then
				-- Optionally update the source to latest editor content (maybe risky but makes sense for "detected tabs")
				-- existing[tab.name].Source = tab.content
			end
		end
		if updated then
			saveAutoExecFile()
		end

		refreshAeList()
		aeIsOpen = true
		aeOverlay.Visible = true
		aeFrame.Visible = true
		aeScale.Scale = 0
		TweenService:Create(aeOverlay, TweenInfo.new(0.3), { BackgroundTransparency = 0.6 }):Play()
		TweenService:Create(aeScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()
	end

	table.insert(
		connections,
		aeOverlay.MouseButton1Click:Connect(function()
			if aeIsOpen then
				closeAe()
			end
		end)
	)

	table.insert(
		connections,
		aeAddBtn.MouseButton1Click:Connect(function()
			local source = inputBox.Text
			if source:gsub("%s", "") == "" then
				log("The current editor tab is empty - nothing to add.", "Warning")
				return
			end
			local name = aeNameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if name == "" then
				name = editorTabs and editorTabs[activeTabIndex] and editorTabs[activeTabIndex].name
					or ("Script " .. (#autoExecScripts + 1))
			end
			table.insert(autoExecScripts, { Name = name, Source = source, Enabled = true })
			aeNameBox.Text = ""
			saveAutoExecFile()
			refreshAeList()
			log("Added '" .. name .. "' to Auto-Execute.", "Info")
		end)
	)

	table.insert(themedUpdaters, function(theme, fontData)
		tintTween(aeFrame, { BackgroundColor3 = theme.Background })
		tintTween(aeStroke, { Color = theme.PrimaryAccent })
		tintTween(aeTitle, { TextColor3 = theme.Text })
		aeTitle.Font = fontData.Bold
		tintTween(aeHint, { TextColor3 = theme.InputEcho })
		tintTween(aeNameBox, { BackgroundColor3 = theme.UtilButton, TextColor3 = theme.Text })
		aeNameBox.Font = fontData.Font
		tintTween(aeAddBtn, { BackgroundColor3 = theme.SecondaryAccent })
		aeAddBtn.Font = fontData.Bold
		tintTween(aeListScroll, { ScrollBarImageColor3 = theme.PrimaryAccent })
	end)
end

-- === Script Hub (📚) ===
-- Browses the public script libraries from inside the client. Same shape as
-- the World Scripthub web app: one request per enabled provider, the results
-- interleaved into a single feed, then a detail page that can copy, load,
-- save or run the source.
--
-- Built inside a function rather than a `do` block: the main chunk sits at
-- Luau's 200-local ceiling, and a function body gets its own register budget
-- while still closing over everything declared above it.
scriptHub.Build = function()
	local HUB_PAGE_SIZE = 12
	-- Roblox TextLabels choke on multi-megabyte sources, so the viewer shows a
	-- prefix while every action still uses the full text.
	local HUB_PREVIEW_LIMIT = 20000
	local HUB_REQUEST_TIMEOUT = 20
	local HUB_ENRICH_TIMEOUT = 8

	-- Shown behind artwork that has not arrived (or cannot be decoded).
	local HUB_FALLBACK_GLYPH = "🎮"

	local function hubJson(url)
		local body = httpGet(url)
		if not body then
			return nil
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if ok and type(data) == "table" then
			return data
		end
		return nil
	end

	local function text(value, fallback)
		if type(value) == "string" and value ~= "" then
			return value
		end
		return fallback
	end

	local function number(value)
		if type(value) == "number" then
			return value
		end
		return tonumber(value) or 0
	end

	-- Takes every field a library might hide the place id in and returns the
	-- first usable one. select() rather than ipairs: the candidates are read
	-- straight off JSON tables, so a nil in the middle of the list is normal
	-- and must not stop the search early.
	local function placeIdOf(...)
		for index = 1, select("#", ...) do
			local id = math.floor(number((select(index, ...))))
			if id > 0 then
				return id
			end
		end
		return 0
	end

	-- Every library marks its "works in any game" entries differently; these
	-- are the game names all of them use for it.
	local universalNames = {
		["universal script"] = true,
		["universal script 📌"] = true,
		["script hub"] = true,
		["universal"] = true,
	}
	local function isUniversal(entry, gameName)
		if entry.universal == true or entry.isUniversal == true or entry.type == "universal" then
			return true
		end
		return type(gameName) == "string" and universalNames[gameName:lower()] == true
	end

	local function formatCount(value)
		local n = number(value)
		if n >= 1000000000 then
			return (string.format("%.1fB", n / 1000000000):gsub("%.0B", "B"))
		elseif n >= 1000000 then
			return (string.format("%.1fM", n / 1000000):gsub("%.0M", "M"))
		elseif n >= 1000 then
			return (string.format("%.1fk", n / 1000):gsub("%.0k", "k"))
		end
		return tostring(math.floor(n))
	end

	local function absoluteUrl(url, base)
		if type(url) ~= "string" or url == "" then
			return nil
		end
		if url:match("^https?://") then
			return url
		end
		return base .. (url:sub(1, 1) == "/" and url or "/" .. url)
	end

	-- === Web artwork ===
	-- Every library hands back plain https image URLs, and an ImageLabel only
	-- takes content ids, so the bytes have to be downloaded, written to disk and
	-- passed through the executor's getcustomasset. Results are cached by URL,
	-- so an image is fetched once per session however many cards use it, and the
	-- files survive as a disk cache between sessions.
	local IMAGE_FOLDER = "WorldClient_Images"
	local IMAGE_MAX_BYTES = 2 * 1024 * 1024
	local PNG_MAGIC = "\137PNG\13\10\26\10"
	local JPEG_MAGIC = "\255\216\255"

	local getCustomAsset = getcustomasset or getsynasset or (syn and syn.getcustomasset)
	local canLoadWebImages = type(getCustomAsset) == "function" and type(writefile) == "function"

	-- rbxcdn serves the same asset in several formats and sizes. Roblox decodes
	-- PNG and JPEG but not WebP, and the large variants run to hundreds of
	-- kilobytes for artwork drawn at 56px, so both get rewritten before the
	-- download. Only the sizes rbxcdn actually publishes are substituted.
	local rbxcdnSizes = {
		["/512/512/"] = "/150/150/",
		["/420/420/"] = "/150/150/",
		["/768/432/"] = "/480/270/",
	}

	local function normalizeImageUrl(url)
		if type(url) ~= "string" or not url:match("^https?://") then
			return nil
		end
		if url:find("rbxcdn.com", 1, true) then
			url = url:gsub("/Image/Webp/", "/Image/Png/")
			for from, to in pairs(rbxcdnSizes) do
				url = url:gsub(from, to, 1)
			end
			return url
		end
		-- Anything served from a library's own CDN has to already be in a format
		-- Roblox can decode; most of them publish WebP, which it cannot.
		local lowered = url:lower()
		if lowered:find("%.webp") or lowered:find("%.gif") or lowered:find("%.svg") then
			return nil
		end
		return url
	end

	-- FNV-1a over the URL: a stable file name, so the same artwork reuses the
	-- same cache file instead of being downloaded again next session.
	local function imagePathFor(url)
		local hash = 2166136261
		for index = 1, #url do
			hash = bit32.bxor(hash, string.byte(url, index))
			hash = (hash * 16777619) % 4294967296
		end
		return ("%s/%08x.png"):format(IMAGE_FOLDER, hash)
	end

	-- Favicons are .ico containers, which Roblox cannot decode - but a modern
	-- one usually just wraps a PNG, and that can be lifted out untouched. Older
	-- BMP-encoded icons have no PNG inside and fall back to the glyph.
	local function extractIcoPng(data)
		if #data < 22 or data:sub(1, 4) ~= "\0\0\1\0" then
			return nil
		end
		local ok, result = pcall(function()
			local count = string.unpack("<I2", data, 5)
			for index = 0, count - 1 do
				local size, offset = string.unpack("<I4I4", data, 15 + index * 16)
				local blob = data:sub(offset + 1, offset + size)
				if blob:sub(1, 8) == PNG_MAGIC then
					return blob
				end
			end
			return nil
		end)
		return ok and result or nil
	end

	local imageAssets = {} -- normalized url -> content id, or false once it has failed
	local imageLoading = {} -- normalized url -> true while a thread is fetching it

	local function resolveImageAsset(url)
		local cached = imageAssets[url]
		if cached ~= nil then
			return cached or nil
		end
		if not canLoadWebImages then
			imageAssets[url] = false
			return nil
		end
		-- A provider logo is shared by every card on the page, so wait on the
		-- thread already fetching it rather than starting a dozen more.
		if imageLoading[url] then
			local deadline = os.clock() + 10
			while imageLoading[url] and os.clock() < deadline do
				task.wait(0.05)
			end
			return imageAssets[url] or nil
		end

		imageLoading[url] = true
		local body = httpGet(url)

		if type(body) == "string" and #body > 0 and #body <= IMAGE_MAX_BYTES then
			if body:sub(1, 8) ~= PNG_MAGIC and body:sub(1, 3) ~= JPEG_MAGIC then
				body = extractIcoPng(body)
			end
		else
			body = nil
		end

		local asset
		if body then
			pcall(function()
				if
					type(isfolder) == "function"
					and type(makefolder) == "function"
					and not isfolder(IMAGE_FOLDER)
				then
					makefolder(IMAGE_FOLDER)
				end
				local path = imagePathFor(url)
				writefile(path, body)
				asset = getCustomAsset(path)
			end)
		end

		imageAssets[url] = (type(asset) == "string" and asset ~= "" and asset) or false
		imageLoading[url] = nil
		return imageAssets[url] or nil
	end

	-- Provider logos: every library publishes only a .ico, and Roblox decodes
	-- neither ICO nor the BMP most of them wrap. Google's favicon service
	-- re-encodes the same icon as a PNG, which does decode, so it is the default
	-- source. Set a provider's Icon to an uploaded decal id to skip the download
	-- entirely; that always wins over this.
	local function faviconUrl(domain)
		return ("https://www.google.com/s2/favicons?domain=%s&sz=64"):format(domain)
	end

	-- Swaps artwork in once it has downloaded, provided the label is still on
	-- screen - searching and paging destroy cards while their images are in
	-- flight.
	local function applyImageAsync(imageLabel, glyphLabel, url)
		local normalized = normalizeImageUrl(url)
		if not normalized then
			return
		end
		task.spawn(function()
			local asset = resolveImageAsset(normalized)
			if asset and imageLabel.Parent then
				imageLabel.Image = asset
				if glyphLabel then
					glyphLabel.Visible = false
				end
			end
		end)
	end

	local hubProviders = {
		{
			Key = "scriptblox",
			Name = "ScriptBlox",
			Icon = "rbxassetid://133394455676372",
			IconUrl = faviconUrl("scriptblox.com"),
			Glyph = "📜",
			Url = function(query, page)
				if query == "" then
					return ("https://scriptblox.com/api/script/fetch?page=%d"):format(page)
				end
				return ("https://scriptblox.com/api/script/search?q=%s&page=%d&max=%d"):format(
					HttpService:UrlEncode(query),
					page,
					HUB_PAGE_SIZE
				)
			end,
			Parse = function(data)
				local list = type(data.result) == "table" and data.result.scripts or data.scripts
				if type(list) ~= "table" then
					return {}
				end
				local out = {}
				for _, s in ipairs(list) do
					if type(s) == "table" and (s._id or s.id) then
						local gameData = type(s.game) == "table" and s.game or {}
						local universal = isUniversal(s, gameData.name)
						table.insert(out, {
							Id = tostring(s._id or s.id),
							Title = text(s.title, "Untitled Script"),
							Creator = text(type(s.owner) == "table" and s.owner.username or nil, "Unknown"),
							Game = universal and "Universal Script" or text(gameData.name, "Unknown Game"),
							PlaceId = universal and 0 or placeIdOf(gameData.gameId, gameData.placeId, s.placeId),
							Views = number(s.views),
							ImageUrl = normalizeImageUrl(gameData.imageUrl)
								or normalizeImageUrl(absoluteUrl(s.image, "https://scriptblox.com")),
							Verified = s.verified == true,
							Universal = universal,
							KeySystem = s.key == true or s.keySystem == true,
							Patched = s.isPatched == true or s.patched == true,
							Mobile = s.mobile == true,
							Source = type(s.script) == "string" and s.script or nil,
						})
					end
				end
				return out
			end,
			-- ScriptBlox's trending feed ships a trimmed record: no owner and no
			-- game id, so cards would read "Unknown" with no thumbnail. The
			-- per-script endpoint has both, so the gaps are backfilled in
			-- parallel before the page is rendered. Search results already carry
			-- the full record and skip this entirely.
			Enrich = function(entries)
				local pending = {}
				for _, entry in ipairs(entries) do
					if
					entry.Creator == "Unknown"
					or not entry.ImageUrl
					or (not entry.Universal and entry.PlaceId == 0)
				then
						table.insert(pending, entry)
					end
				end
				if #pending == 0 then
					return
				end

				local remaining = #pending
				for _, entry in ipairs(pending) do
					task.spawn(function()
						local data = hubJson("https://scriptblox.com/api/script/" .. entry.Id)
						local detail = data and type(data.script) == "table" and data.script or nil
						if detail then
							local gameData = type(detail.game) == "table" and detail.game or {}
							if entry.PlaceId == 0 and not entry.Universal then
								entry.PlaceId = placeIdOf(gameData.gameId, gameData.placeId)
							end
							if entry.Creator == "Unknown" and type(detail.owner) == "table" then
								entry.Creator = text(detail.owner.username, "Unknown")
							end
							if not entry.Source and type(detail.script) == "string" then
								entry.Source = detail.script
							end
							if not entry.ImageUrl then
								entry.ImageUrl = normalizeImageUrl(gameData.imageUrl)
									or normalizeImageUrl(absoluteUrl(detail.image, "https://scriptblox.com"))
							end
						end
						remaining -= 1
					end)
				end

				local deadline = os.clock() + HUB_ENRICH_TIMEOUT
				while remaining > 0 and os.clock() < deadline do
					task.wait(0.1)
				end
			end,
			-- The list endpoint omits the source on some entries; the per-script
			-- endpoint always carries it.
			DetailUrl = function(entry)
				return "https://scriptblox.com/api/script/" .. entry.Id
			end,
			DetailParse = function(data)
				if type(data.script) == "table" and type(data.script.script) == "string" then
					return data.script.script
				end
				return nil
			end,
		},
		{
			Key = "rscripts",
			Name = "Rscripts",
			Icon = "rbxassetid://107527701431712",
			IconUrl = faviconUrl("rscripts.net"),
			Glyph = "📘",
			Url = function(query, page)
				if query == "" then
					return ("https://rscripts.net/api/v2/scripts?page=%d"):format(page)
				end
				return ("https://rscripts.net/api/v2/scripts?q=%s&page=%d&orderBy=date&sort=desc"):format(
					HttpService:UrlEncode(query),
					page
				)
			end,
			Parse = function(data)
				local list = type(data.scripts) == "table" and data.scripts or data.success
				if type(list) ~= "table" then
					return {}
				end
				local out = {}
				for _, s in ipairs(list) do
					if type(s) == "table" and (s.id or s._id) then
						local gameData = type(s.game) == "table" and s.game or {}
						local gameName = text(gameData.title, text(gameData.name, "Unknown Game"))
						local universal = isUniversal(s, gameName)
						local user = type(s.user) == "table" and s.user or {}
						table.insert(out, {
							Id = tostring(s.id or s._id),
							Title = text(s.title, "Untitled Script"),
							Creator = text(user.username, "Unknown"),
							Game = universal and "Universal Script" or gameName,
							PlaceId = universal and 0 or placeIdOf(gameData.gameId, gameData.placeId, s.placeId),
							Views = number(s.views),
							-- s.image is WebP on the Rscripts CDN; the rbxcdn copies
							-- on the game record convert cleanly, so prefer those.
							ImageUrl = normalizeImageUrl(gameData.imgurl)
								or normalizeImageUrl(gameData.gameLogo)
								or normalizeImageUrl(s.image),
							Verified = user.verified == true,
							Universal = universal,
							KeySystem = s.keySystem == true,
							Patched = s.patched == true,
							Mobile = s.mobileReady == true,
							-- Rscripts hands back a URL rather than the source.
							RawUrl = type(s.rawScript) == "string" and s.rawScript or nil,
						})
					end
				end
				return out
			end,
		},
		{
			Key = "robloxscripts",
			Name = "Roblox Scripts",
			Icon = "rbxassetid://108219075398216",
			IconUrl = faviconUrl("robloxscripts.com"),
			Glyph = "🟡",
			Url = function(query, page)
				if query == "" then
					return ("https://robloxscripts.com/api/v1/scripts?page=%d&limit=%d"):format(page, HUB_PAGE_SIZE)
				end
				return ("https://robloxscripts.com/api/v1/scripts?q=%s&page=%d&limit=%d"):format(
					HttpService:UrlEncode(query),
					page,
					HUB_PAGE_SIZE
				)
			end,
			Parse = function(data)
				local list = type(data.data) == "table" and data.data or data.scripts
				if type(list) ~= "table" then
					return {}
				end
				local out = {}
				for _, s in ipairs(list) do
					if type(s) == "table" and (s.id or s._id) then
						local gameData = type(s.game) == "table" and s.game or {}
						local gameName = text(gameData.name, type(s.game) == "string" and s.game or "Unknown Game")
						local universal = isUniversal(s, gameName)
						local author = type(s.author) == "table" and s.author or {}
						local flags = type(s.flags) == "table" and s.flags or {}
						table.insert(out, {
							Id = tostring(s.id or s._id),
							Title = text(s.title, "Untitled Script"),
							Creator = text(
								author.username,
								text(author.name, type(s.author) == "string" and s.author or "Unknown")
							),
							Game = universal and "Universal Script" or gameName,
							PlaceId = universal and 0 or placeIdOf(gameData.placeId, s.placeId, gameData.universeId),
							Views = number(s.views ~= nil and s.views or (type(s.stats) == "table" and s.stats.views)),
							ImageUrl = normalizeImageUrl(gameData.iconUrl)
								or normalizeImageUrl(gameData.thumbnailUrl)
								or normalizeImageUrl(s.image),
							Verified = s.verified == true or author.verified == true or author.isVerified == true,
							Universal = universal,
							KeySystem = s.key == true or s.keySystem == true or flags.keySystem == true,
							Patched = s.patched == true or flags.patched == true,
							Mobile = s.mobile == true or s.mobileSupported == true or flags.mobileSupported == true,
							Source = type(s.script) == "string" and s.script or nil,
							-- The listing calls it rawScriptUrl; keep the other two
							-- spellings as a fallback in case the field is renamed.
							RawUrl = type(s.rawScriptUrl) == "string" and s.rawScriptUrl
								or type(s.rawScript) == "string" and s.rawScript
								or (type(s.links) == "table" and type(s.links.raw) == "string" and s.links.raw or nil),
						})
					end
				end
				return out
			end,
		},
		{
			Key = "haxhell",
			Name = "HaxHell",
			Icon = "rbxassetid://74042163033078",
			IconUrl = faviconUrl("haxhell.com"),
			Glyph = "🔥",
			Url = function(query, page)
				if query == "" then
					return ("https://haxhell.com/api/v1/scripts?page=%d&limit=%d"):format(page, HUB_PAGE_SIZE)
				end
				return ("https://haxhell.com/api/v1/search/scripts?q=%s&page=%d&limit=%d"):format(
					HttpService:UrlEncode(query),
					page,
					HUB_PAGE_SIZE
				)
			end,
			Parse = function(data)
				local list = type(data.data) == "table" and data.data or data.scripts
				if type(list) ~= "table" then
					return {}
				end
				local out = {}
				for _, s in ipairs(list) do
					if type(s) == "table" and (s.id or s._id) then
						local gameData = type(s.game) == "table" and s.game or {}
						local universal = isUniversal(s, gameData.name)
						local author = type(s.author) == "table" and s.author or {}
						local flags = type(s.flags) == "table" and s.flags or {}
						local stats = type(s.stats) == "table" and s.stats or {}
						table.insert(out, {
							Id = tostring(s.id or s._id),
							Title = text(s.title, "Untitled Script"),
							Creator = text(author.username, "Unknown"),
							Game = universal and "Universal Script" or text(gameData.name, "Unknown Game"),
							PlaceId = universal and 0 or placeIdOf(gameData.placeId, gameData.universeId, s.placeId),
							Views = number(stats.views),
							ImageUrl = normalizeImageUrl(gameData.thumbnailUrl)
								or normalizeImageUrl(gameData.iconUrl)
								or normalizeImageUrl(type(s.media) == "table" and s.media.thumbnailUrl or nil),
							Verified = author.isScripterVerified == true,
							Universal = universal,
							KeySystem = flags.keySystem == true,
							Patched = flags.patched == true,
							Mobile = flags.mobileSupported == true,
							RawUrl = type(s.links) == "table" and type(s.links.raw) == "string" and s.links.raw or nil,
						})
					end
				end
				return out
			end,
