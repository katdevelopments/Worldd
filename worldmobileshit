	local HUB_MARKS_FILE = "WorldClient_HubMarks.json"
	local favoriteKeys, hiddenKeys = {}, {}

	pcall(function()
		local data = HttpService:JSONDecode(readfile(HUB_MARKS_FILE))
		if type(data) == "table" then
			for _, key in ipairs(type(data.favorites) == "table" and data.favorites or {}) do
				if type(key) == "string" then
					favoriteKeys[key] = true
				end
			end
			for _, key in ipairs(type(data.hidden) == "table" and data.hidden or {}) do
				if type(key) == "string" then
					hiddenKeys[key] = true
				end
			end
		end
	end)

	local function saveHubMarks()
		pcall(function()
			local favorites, hidden = {}, {}
			for key in pairs(favoriteKeys) do
				table.insert(favorites, key)
			end
			for key in pairs(hiddenKeys) do
				table.insert(hidden, key)
			end
			writefile(HUB_MARKS_FILE, HttpService:JSONEncode({ favorites = favorites, hidden = hidden }))
		end)
	end

