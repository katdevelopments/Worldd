	-- === Grid sizing ===
	-- Cells are sized in pixels from the measured width of the scroll frame:
	-- a scale-based cell cannot account for the gaps between columns, and the
	-- panel is resizable, so the maths is redone whenever the width changes.
	--
	-- Card contents are dropped as the cells get narrower. Three across on a
	-- phone leaves well under 100px per card, which fits a title and little
	-- else, so the tag pills and the action row bow out and tapping the card
	-- opens the detail page instead - where those actions live anyway.
	local ACTIONS_MIN_WIDTH = 210
	local TAGS_MIN_WIDTH = 150
	local PROVIDER_NAME_MIN_WIDTH = 130
	local META_MIN_WIDTH = 115
	-- Row heights, mirroring the sizes createCard gives them.
	local ROW_HEIGHTS = { Title = 19, Meta = 14, Tags = 16, Stats = 13, Actions = 26 }
	local ROW_GAP, CONTENT_INSET = 3, 40

	local function updateGrid()
		local columns = math.clamp(scriptHub.Columns or 3, 1, 4)
		local available = resultScroll.AbsoluteSize.X - resultScroll.ScrollBarThickness - 2
		if available <= 0 then
			return
		end

		local cellWidth = math.max(math.floor((available - CARD_GAP * (columns - 1)) / columns), 60)
		local showActions = cellWidth >= ACTIONS_MIN_WIDTH
		local showTags = cellWidth >= TAGS_MIN_WIDTH
		local showMeta = cellWidth >= META_MIN_WIDTH
		local showProviderName = cellWidth >= PROVIDER_NAME_MIN_WIDTH

		-- The card only has to be as tall as the rows it is actually showing,
		-- so a narrow three-across card is a compact poster rather than a
		-- tall strip padded out with empty space.
		local stack, rows = ROW_HEIGHTS.Title + ROW_HEIGHTS.Stats, 2
		if showMeta then
			stack += ROW_HEIGHTS.Meta
			rows += 1
		end
		if showTags then
			stack += ROW_HEIGHTS.Tags
			rows += 1
		end
		if showActions then
			stack += ROW_HEIGHTS.Actions
			rows += 1
		end
		local minHeight = stack + ROW_GAP * (rows - 1) + CONTENT_INSET

		local cellHeight
		if columns == 1 then
