	-- === Filtering ===
	-- Runs over the entries already loaded and shows or hides their cards, so
	-- changing a filter is instant and never refetches. Hidden scripts are
	-- always excluded unless the Hidden filter is the one asking for them.
	local function passesRangeFilters(entry)
		local placeIdText = rangeFilters.placeId
		if placeIdText ~= "" then
			local id = tostring(entry.PlaceId or 0)
			if id == "0" or not id:find(placeIdText, 1, true) then
				return false
			end
		end

		local minViews = tonumber(rangeFilters.minViews)
		local maxViews = tonumber(rangeFilters.maxViews)
		if (minViews and entry.Views < minViews) or (maxViews and entry.Views > maxViews) then
			return false
		end

		local minPlayers = tonumber(rangeFilters.minPlayers)
		local maxPlayers = tonumber(rangeFilters.maxPlayers)
		if minPlayers or maxPlayers then
			-- Player counts arrive from the Roblox API after the page renders;
			-- an entry with no number yet cannot satisfy a player filter.
			local players = entry.ActivePlayers
			if not players then
				return false
			end
			if (minPlayers and players < minPlayers) or (maxPlayers and players > maxPlayers) then
				return false
			end
		end
		return true
	end

	local function passesFilters(entry)
		local key = entryKey(entry)
		-- Both sides have to be normalised to booleans: an unmarked script is
		-- nil in the set, not false, and nil ~= false would reject everything.
		if (hiddenKeys[key] == true) ~= (activeFilters.hidden == true) then
			return false
		end
		if not passesRangeFilters(entry) then
			return false
		end
		if activeFilters.all then
			return true
		end
		for filter, on in pairs(activeFilters) do
			if on and filter ~= "hidden" then
				local ok
				if filter == "favorites" then
					ok = favoriteKeys[key] == true
				elseif filter == "popular" then
					ok = entry.Views > POPULAR_VIEWS
				elseif filter == "good" then
					ok = entry.Views > GOOD_REVIEW_VIEWS
				elseif filter == "bad" then
					ok = entry.Views <= GOOD_REVIEW_VIEWS
				elseif filter == "verified" then
					ok = entry.Verified == true
				elseif filter == "universal" then
					ok = entry.Universal == true
				elseif filter == "undefined" then
					ok = isUndefinedEntry(entry)
				elseif filter == "patched" then
					ok = entry.Patched == true
				elseif filter == "mobile" then
					ok = entry.Mobile == true
				elseif filter == "keysystem" then
					ok = entry.KeySystem == true
				else
					ok = true
				end
				if not ok then
					return false
				end
			end
		end
		return true
	end

	function applyFilters()
		local shown = 0
		for _, entry in ipairs(hubEntries) do
			if entry.Card and entry.Card.Parent then
				local visible = passesFilters(entry)
				entry.Card.Visible = visible
				if visible then
					shown += 1
				end
			end
		end

		if #hubEntries == 0 then
			return shown
		end
		if shown == 0 then
			setHubStatus(tr("Nothing matches these filters - clear one or load more."))
		else
			setHubStatus(("%d/%d "):format(shown, #hubEntries) .. tr("scripts shown"))
		end
		return shown
	end

