	activeTweens.glowTransparency:Play()
	activeTweens.glowThickness:Play()
	activeTweens.strokeSpin:Play()
end

local function stopGlow()
	for _, key in ipairs({ "glowTransparency", "glowThickness", "strokeSpin" }) do
		if activeTweens[key] then
