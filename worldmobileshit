	-- Shared with the Script Hub so a downloaded script lands in the same
	-- library, under a name that never collides with an existing entry.
	function scriptHub.AddSaved(name, source)
		if type(source) ~= "string" or source:gsub("%s", "") == "" then
			return nil
		end
		local base = (type(name) == "string" and name or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if base == "" then
			base = "Script " .. tostring(#savedScripts + 1)
		end
		local unique = base
		local suffix = 2
		local function taken(candidate)
			for _, item in ipairs(savedScripts) do
				if item.Name == candidate then
					return true
				end
			end
			return false
		end
		while taken(unique) do
			unique = base .. " (" .. suffix .. ")"
			suffix += 1
		end
		table.insert(savedScripts, { Name = unique, Source = source })
		saveScriptsFile()
		if scriptsFrame.Visible then
			refreshScriptsList()
		end
		return unique
	end

