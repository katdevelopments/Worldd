		{ Label = "All", Filter = "All", Width = 40 },
		{ Label = "ℹ️", Filter = "Info", Width = 26 },
		{ Label = "⚠️", Filter = "Warning", Width = 26 },
		{ Label = "⛔", Filter = "Error", Width = 26 },
	}) do
		local chip = Instance.new("TextButton", filterBar)
		chip.LayoutOrder = 1 + order
		chip.Size = UDim2.new(0, def.Width, 1, 0)
		chip.BackgroundColor3 = CONFIG.Colors.UtilButton
