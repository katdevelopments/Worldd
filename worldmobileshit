	-- rbxthumb resolves natively and instantly, so a known place id paints the
	-- game's icon straight away; the library's own banner art is nicer but has
	-- to be downloaded, so it is swapped in over the top once it lands.
	local function thumbnailFor(entry)
		if entry.PlaceId and entry.PlaceId > 0 then
			return ("rbxthumb://type=GameIcon&id=%d&w=150&h=150"):format(entry.PlaceId)
		end
		return ""
	end

	local function paintThumbnail(imageLabel, glyphLabel, entry)
		local instant = thumbnailFor(entry)
		imageLabel.Image = instant
		glyphLabel.Visible = instant == ""
		applyImageAsync(imageLabel, glyphLabel, entry.ImageUrl)
	end

	-- Provider badge: an uploaded decal wins, then the site's own icon fetched
	-- at runtime, and the glyph stands in until (or unless) one of those lands.
	local function createProviderBadge(parent, provider, size, zIndex)
		local badge = Instance.new("ImageLabel", parent)
		badge.Size = UDim2.new(0, size, 0, size)
		badge.BackgroundTransparency = 1
		badge.Image = provider and provider.Icon or ""
		badge.ZIndex = zIndex

		local glyph = Instance.new("TextLabel", badge)
		glyph.Size = UDim2.new(1, 0, 1, 0)
		glyph.BackgroundTransparency = 1
		glyph.Font = Enum.Font.SourceSans
		glyph.Text = provider and provider.Glyph or "❔"
		glyph.TextColor3 = CONFIG.Colors.Text
		glyph.TextSize = size
		glyph.Visible = badge.Image == ""
		glyph.ZIndex = zIndex

		if provider then
			if badge.Image == "" then
				applyImageAsync(badge, glyph, provider.IconUrl)
			else
				-- An uploaded asset that is still pending moderation, or was
				-- rejected, never finishes loading and would leave an empty
				-- square. Give it a moment, then fall back to the downloaded
				-- favicon rather than showing nothing.
				task.spawn(function()
					local deadline = os.clock() + 5
					while not badge.IsLoaded and os.clock() < deadline do
						task.wait(0.25)
					end
					if not badge.IsLoaded and badge.Parent then
						badge.Image = ""
						glyph.Visible = true
						applyImageAsync(badge, glyph, provider.IconUrl)
					end
				end)
			end
		end
		return badge
	end

	-- The view thresholds the web hub uses to label a script popular or
	-- well/poorly reviewed, kept here so the tags and the filters agree.
	local POPULAR_VIEWS = 500000
	local GOOD_REVIEW_VIEWS = 100000

	local function isUndefinedEntry(entry)
		return not entry.Verified and not entry.Universal
	end

	-- Dark chips read as warnings, light chips as neutral facts - the same
	-- split the web cards make.
	local function tagsFor(entry)
		local tags = {}
		if entry.Views > POPULAR_VIEWS then
			table.insert(tags, { Label = "🔥 Popular" })
		end
		if entry.Views > GOOD_REVIEW_VIEWS then
			table.insert(tags, { Label = "👍 Good reviews" })
		else
			table.insert(tags, { Label = "👎 Bad reviews", Dark = true })
		end
		if entry.Verified then
			table.insert(tags, { Label = "🛡️ Verified" })
		end
		if entry.Universal then
			table.insert(tags, { Label = "🌐 Universal" })
		end
		if isUndefinedEntry(entry) then
			table.insert(tags, { Label = "❔ Undefined" })
		end
		if entry.KeySystem then
			table.insert(tags, { Label = "🔑 Key", Dark = true })
		end
		if entry.Patched then
			table.insert(tags, { Label = "⛔ Patched", Dark = true })
		end
		if entry.Mobile then
			table.insert(tags, { Label = "📱 Mobile" })
		end
		return tags
	end

	-- === Source resolution ===
	-- Some libraries inline the source in the listing, some only give a raw
	-- URL, and ScriptBlox occasionally needs a second call for it.
	local function resolveSource(entry)
		if type(entry.Source) == "string" and entry.Source ~= "" then
			return entry.Source
		end
		if type(entry.RawUrl) == "string" and entry.RawUrl ~= "" then
			local body = httpGet(entry.RawUrl)
			if type(body) == "string" and body ~= "" then
				return body
			end
		end
		local provider = hubProviderByKey[entry.Provider]
		if provider and provider.DetailUrl and provider.DetailParse then
			local data = hubJson(provider.DetailUrl(entry))
			if data then
				local source = provider.DetailParse(data)
				if type(source) == "string" and source ~= "" then
					return source
				end
			end
		end
		return nil
	end

	local function closeDetail()
		if not detailFrame.Visible then
			return
		end
		hubDetailToken += 1
		TweenService:Create(detailOverlay, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
		local tween = TweenService:Create(
			detailScale,
			TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In),
			{ Scale = 0 }
		)
		tween:Play()
		tween.Completed:Wait()
		detailOverlay.Visible = false
		detailFrame.Visible = false
		hubDetailEntry = nil
	end

	local function openDetail(entry)
		hubDetailEntry = entry
		hubDetailToken += 1
		local token = hubDetailToken

		detailTitle.Text = entry.Title
		local metaParts = {
			entry.ProviderName,
			entry.Game,
			"👤 " .. entry.Creator,
			"👁️ " .. formatCount(entry.Views),
		}
		for _, tag in ipairs(tagsFor(entry)) do
			table.insert(metaParts, tag.Label)
		end
		detailMeta.Text = table.concat(metaParts, "  •  ")

		paintThumbnail(detailThumb, detailThumbGlyph, entry)

		codeLabel.Text = tr("Loading script source...")
		codeScroll.CanvasPosition = Vector2.new(0, 0)

		detailOverlay.Visible = true
		detailFrame.Visible = true
		TweenService:Create(detailOverlay, TweenInfo.new(0.25), { BackgroundTransparency = 0.5 }):Play()
		detailScale.Scale = 0
		TweenService
			:Create(detailScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()

		task.spawn(function()
			local source = resolveSource(entry)
			if token ~= hubDetailToken then
				return
			end
			if source then
				entry.Source = source
				if #source > HUB_PREVIEW_LIMIT then
					codeLabel.Text = source:sub(1, HUB_PREVIEW_LIMIT)
						.. "\n\n-- "
						.. tr("Preview truncated - Copy, Editor, Save and Run still use the full script.")
				else
					codeLabel.Text = source
				end
			else
				codeLabel.Text = tr("Failed to load this script's source.")
			end
		end)
	end

	registerLocalizedString("Loading script source...")
	registerLocalizedString("Failed to load this script's source.")
	registerLocalizedString("Preview truncated - Copy, Editor, Save and Run still use the full script.")

	-- === Actions ===
	-- Copy / Editor / Save / Run behave identically on a result card and on the
	-- detail page, so both routes go through here. The source may still be
	-- downloading when the button is tapped, so it is resolved first either way.
	local function performAction(entry, action, source)
		if action == "copy" then
			if pcall(setclipboard, source) then
				log("Copied '" .. entry.Title .. "' to the clipboard.", "Info")
			else
				log("This executor does not expose setclipboard.", "Error")
			end
		elseif action == "editor" then
			inputBox.Text = source
			closeDetail()
			if isHubOpen then
				toggleHub()
			end
			log("Loaded '" .. entry.Title .. "' into the editor.", "Info")
		elseif action == "save" then
			if not scriptHub.AddSaved then
				log("Saved scripts are unavailable on this executor.", "Error")
				return
			end
			local name = scriptHub.AddSaved(entry.Title, source)
			if name then
				log("Saved '" .. name .. "' to your script library.", "Info")
			else
				log("Could not save '" .. entry.Title .. "'.", "Error")
			end
		elseif action == "run" then
			if not isExecuteScriptEnabled then
				log("Cannot run '" .. entry.Title .. "': no executor available.", "Error")
				return
			end
			log("Running '" .. entry.Title .. "'...", "Info")
			task.spawn(function()
				local ok, err = pcall(executeScript, source)
				if not ok then
					log("Runtime Error: " .. tostring(err), "Error")
				end
			end)
		end
	end

	-- The spinner replaces the button label while the download runs, so a
	-- second tap has to be ignored or it would capture "⏳" as the label to
	-- restore afterwards.
	local busyButtons = {}
	local function runEntryAction(entry, action, button)
		if not entry or busyButtons[button] then
			return
		end
		busyButtons[button] = true
		local originalText = button.Text
		button.Text = "⏳"
		createClickParticles(button)
		task.spawn(function()
			local source = resolveSource(entry)
			if button.Parent then
				button.Text = originalText
			end
			busyButtons[button] = nil
			if not source then
				log("Script Hub: could not download '" .. entry.Title .. "'.", "Error")
				return
			end
			entry.Source = source
			performAction(entry, action, source)
		end)
	end

