		addDepthGradient(chip)
		safeSetCursor(chip, "rbxasset://SystemCursor/Arrow")
		chipButtons[def.Filter] = chip
		table.insert(
			connections,
			chip.MouseButton1Click:Connect(function()
				activeFilter = def.Filter
				updateChipVisuals()
				applyLogFilter()
			end)
		)
	end
	updateChipVisuals()

	-- Auto-scroll is a master switch in Settings; scrolling up still
	-- temporarily suspends the follow until you return to the bottom.
	local followingBottom = uiSettings.autoScroll
	local suppressScrollDetect = false

	function scrollLogsToBottom(force)
		if not uiSettings.autoScroll and not force then
			return
		end
		if force then
			followingBottom = true
		end
		if not followingBottom then
			return
		end
		suppressScrollDetect = true
		task.defer(function()
			logContainer.CanvasPosition = Vector2.new(0, math.max(0, logContainer.AbsoluteCanvasSize.Y))
			task.delay(0.05, function()
				suppressScrollDetect = false
			end)
		end)
	end

	function setAutoScroll(on)
		uiSettings.autoScroll = on
		followingBottom = on
		if on then
			scrollLogsToBottom(true)
		end
	end

	-- Scrolling up suspends auto-scroll; returning to the bottom re-arms it
	table.insert(
		connections,
		logContainer:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			if suppressScrollDetect or not uiSettings.autoScroll then
				return
			end
			local maxScroll = logContainer.AbsoluteCanvasSize.Y - logContainer.AbsoluteSize.Y
			if maxScroll <= 0 then
				return
			end
			followingBottom = logContainer.CanvasPosition.Y >= maxScroll - 40
		end)
	)

	table.insert(
		connections,
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			searchQuery = searchBox.Text:lower()
			applyLogFilter()
		end)
	)

	table.insert(themedUpdaters, function(theme, fontData)
		tintTween(searchBox, { BackgroundColor3 = theme.UtilButton, TextColor3 = theme.Text })
		searchBox.Font = fontData.Font
		for _, chip in pairs(chipButtons) do
			tintTween(chip, { BackgroundColor3 = theme[chip:GetAttribute("ColorType")] })
		end
	end)
end

