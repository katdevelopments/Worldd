	local pages = tutorialPages
	local currentPage = 1
	local renderedPage = nil

	local updatePage, closeTutorial, advance, back

	function advance()
		if tutorialState.closing then
			return
		end
		if currentPage < #pages then
			currentPage += 1
			updatePage()
		else
			closeTutorial(true)
		end
	end

	function back()
		if tutorialState.closing or currentPage <= 1 then
			return
		end
		currentPage -= 1
		updatePage()
	end

	function updatePage()
		if not card.Parent then
			return
		end
		local pageData = pages[currentPage]

		if pageData.DynamicTitle then
			tutTitle.Text = tr("Welcome") .. ", " .. player.DisplayName .. "!"
		else
			tutTitle.Text = tr(pageData.Title)
		end
		tutBody.Text = tr(pageData.Text)
		Icons.setName(tutIcon, pageData.Icon)
		skipButton.Text = tr("Skip")

		introPanel.Visible = pageData.Kind == "intro"
		if introPanel.Visible then
			Icons.setText(langSearch, tr("Search language..."))
			Icons.setText(discordButtonTour, tr("Join our Discord"))
		end

		counter.Text = currentPage .. " / " .. #pages
		local fillSize = UDim2.new(currentPage / #pages, 0, 1, 0)
		if renderedPage == currentPage then
			progressFill.Size = fillSize
		else
			renderedPage = currentPage
			TweenService:Create(progressFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = fillSize,
			}):Play()
		end

		prevButton.Visible = currentPage > 1
		skipButton.Visible = (currentPage ~= #pages)
		Icons.setName(nextButton, (currentPage == #pages) and "checkCircle" or "arrowRight")
		syncTitleWidth()
	end

	function closeTutorial(completed)
		if tutorialState.closing or not card.Parent then
			return
		end
		tutorialState.closing = true
		tutorialState.restyle = nil
		tutorialState.refresh = nil

		for _, conn in ipairs(tourConnections) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		table.clear(tourConnections)

		for _, btn in ipairs({ prevButton, nextButton }) do
			local at = table.find(utilButtons, btn)
			if at then
				table.remove(utilButtons, at)
			end
		end

		if not tutorialCompleted then
			tutorialCompleted = true
			saveSettings()
		end
		if not completed and log then
			log(tr("Tutorial skipped. Reopen it any time from Settings > Replay Tutorial."), "Info")
		end

		if dimOverlay.Parent then
			TweenService:Create(dimOverlay, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.delay(0.3, function()
				if dimOverlay.Parent then
					dimOverlay:Destroy()
				end
			end)
		end
		local tween =
			TweenService:Create(cardScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 })
		tween:Play()
		tween.Completed:Wait()
		if card.Parent then
			card:Destroy()
		end
		tutorialState.active = false
		tutorialState.closing = false
	end

	local function attachGestures(target, tapAdvances, blocked)
		local startX, startInput = nil, nil
		track(target.InputBegan:Connect(function(input)
			if blocked and blocked() then
				return
			end
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				startX = input.Position.X
				startInput = input
			end
		end))
		track(target.InputEnded:Connect(function(input)
			if startInput == nil or input ~= startInput then
				return
			end
			local delta = input.Position.X - startX
			startX, startInput = nil, nil
			if delta <= -40 then
				advance()
			elseif delta >= 40 then
				back()
			elseif tapAdvances and math.abs(delta) < 12 then
				advance()
			end
		end))
	end
	attachGestures(dimOverlay, true)
	attachGestures(card, false, function()
		return introPanel.Visible
	end)

	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not card.Parent then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Escape then
			closeTutorial(currentPage == #pages)
		elseif
			key == Enum.KeyCode.Return
			or key == Enum.KeyCode.KeypadEnter
			or key == Enum.KeyCode.Space
			or key == Enum.KeyCode.Right
			or key == Enum.KeyCode.Down
		then
			advance()
		elseif key == Enum.KeyCode.Left or key == Enum.KeyCode.Up then
			back()
		end
	end))

	track(prevButton.MouseButton1Click:Connect(back))
	track(nextButton.MouseButton1Click:Connect(advance))
