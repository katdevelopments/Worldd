local controls
do
local ok, result = pcall(function()
	local playerScripts = player:WaitForChild("PlayerScripts", 10)
	if not playerScripts then
		return nil
	end
	local playerModule = playerScripts:WaitForChild("PlayerModule", 10)
	if not playerModule then
		return nil
	end
	return require(playerModule):GetControls()
end)

if ok and type(result) == "table" and type(result.Enable) == "function" and type(result.Disable) == "function" then
	controls = result
else
	warn("[World] PlayerModule controls unavailable; movement will not be disabled while the console is focused.")
	controls = {
		Enable = function() end,
		Disable = function() end,
	}
end
end

if playerGui:FindFirstChild("WorldClientKeybindGui") then
	return true
end

local executeScript = nil
local executorType = nil

pcall(function()
	if getgenv and getgenv().execute_script then
		executeScript = getgenv().execute_script
		executorType = "execute_script"
	end
end)

if not executeScript then
	pcall(function()
		if loadstring then
			executeScript = function(source)
				local fn, compileErr = loadstring(source)
				if not fn then
					error(compileErr, 0)
				end
				return fn()
			end
			executorType = "loadstring"
		end
	end)
end

