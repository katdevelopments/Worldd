	local universeCache = {}
	local function enrichGameStats(entries)
		local places = {}
		for _, entry in ipairs(entries) do
			local id = entry.PlaceId
			if id and id > 0 and not universeCache[id] then
				places[id] = true
			end
		end

		local pending = {}
		for id in pairs(places) do
			table.insert(pending, id)
		end
		if #pending == 0 then
			return
		end

		local remaining = #pending
		for _, id in ipairs(pending) do
			task.spawn(function()
				local data = hubJson(("https://apis.roblox.com/universes/v1/places/%d/universe"):format(id))
				universeCache[id] = data and number(data.universeId) or false
				remaining -= 1
			end)
		end
		local deadline = os.clock() + 10
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end

		local universeIds, byUniverse = {}, {}
		for _, id in ipairs(pending) do
			local universeId = universeCache[id]
			if universeId and universeId > 0 then
				table.insert(universeIds, tostring(universeId))
				byUniverse[universeId] = id
			end
		end
		if #universeIds == 0 then
			return
		end

		local stats = {}
		for start = 1, #universeIds, 50 do
			local chunk = table.concat(universeIds, ",", start, math.min(start + 49, #universeIds))
			local data = hubJson("https://games.roblox.com/v1/games?universeIds=" .. chunk)
			for _, game in ipairs(data and type(data.data) == "table" and data.data or {}) do
				local placeId = byUniverse[number(game.id)]
				if placeId then
					stats[placeId] = { Playing = number(game.playing), Visits = number(game.visits) }
				end
			end
		end

		for _, entry in ipairs(entries) do
			local stat = stats[entry.PlaceId]
			if stat then
				entry.ActivePlayers = stat.Playing
				entry.Visits = stat.Visits
				if entry.RefreshStats and entry.Card and entry.Card.Parent then
					entry.RefreshStats()
				end
			end
		end
	end

	local function fetchHubPage(reset)
		if hubLoading then
			return
		end
		if not reset and not hubHasMore then
			return
		end

		hubLoading = true
		setLoadMoreVisible(false)
		if reset then
			hubRequestId += 1
			hubPage = 1
			hubHasMore = true
			table.clear(hubEntries)
			table.clear(hubSeen)
			clearCards()
			resultScroll.CanvasPosition = Vector2.new(0, 0)
		end

		local requestId = hubRequestId
		local page = hubPage
		local query = hubQuery
		setHubStatus(reset and tr("Loading scripts...") or tr("Loading more scripts..."))

		task.spawn(function()
			local active = {}
			for _, provider in ipairs(hubProviders) do
				if scriptHub.Providers[provider.Key] then
					table.insert(active, provider)
				end
			end

			if #active == 0 then
				hubLoading = false
				if requestId == hubRequestId then
					setHubStatus(tr("Enable at least one provider to see scripts."), true)
				end
				return
			end

			local batches = {}
			local remaining = #active
			for index, provider in ipairs(active) do
				task.spawn(function()
					local ok, parsed = pcall(function()
						local data = hubJson(provider.Url(query, page))
						return data and provider.Parse(data) or {}
					end)
					batches[index] = (ok and type(parsed) == "table") and parsed or {}
					for _, entry in ipairs(batches[index]) do
						entry.Provider = provider.Key
						entry.ProviderName = provider.Name
					end
					if provider.Enrich then
						pcall(provider.Enrich, batches[index])
					end
					remaining -= 1
				end)
			end

			local deadline = os.clock() + HUB_REQUEST_TIMEOUT
			while remaining > 0 and os.clock() < deadline do
				task.wait(0.1)
			end

			if requestId ~= hubRequestId then
				hubLoading = false
				return
			end

			local longest = 0
			for index = 1, #active do
				longest = math.max(longest, #(batches[index] or {}))
			end

			local added = 0
			local fresh = {}
			for row = 1, longest do
				for index = 1, #active do
					local entry = batches[index] and batches[index][row]
					if entry then
						local key = entryKey(entry)
						if not hubSeen[key] then
							hubSeen[key] = true
							table.insert(hubEntries, entry)
							table.insert(fresh, entry)
							createCard(entry, #hubEntries)
							added += 1
						end
					end
				end
			end

			hubLoading = false
			hubPage = page + 1
			hubHasMore = added > 0

			if #hubEntries == 0 then
				setHubStatus(tr("No scripts found. Try a different search."))
			else
				updateGrid()
				applyFilters()
			end
			setLoadMoreVisible(hubHasMore and #hubEntries > 0)

			if #fresh > 0 then
				task.spawn(function()
					pcall(enrichGameStats, fresh)
					if requestId == hubRequestId then
						applyFilters()
					end
				end)
			end
		end)
	end

