scriptHub.Build = function()
	local HUB_PAGE_SIZE = 12
	local HUB_PREVIEW_LIMIT = 20000
	local HUB_REQUEST_TIMEOUT = 20
	local HUB_ENRICH_TIMEOUT = 8

	local HUB_FALLBACK_GLYPH = "gamepad"

	local function hubJson(url)
		local body = httpGet(url)
		if not body then
			return nil
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if ok and type(data) == "table" then
			return data
		end
		return nil
	end

	local function text(value, fallback)
		if type(value) == "string" and value ~= "" then
			return value
		end
		return fallback
	end

	local function number(value)
		if type(value) == "number" then
			return value
		end
		return tonumber(value) or 0
	end

	local function placeIdOf(...)
		for index = 1, select("#", ...) do
			local id = math.floor(number((select(index, ...))))
			if id > 0 then
				return id
			end
		end
		return 0
	end

	local universalNames = {
		["universal script"] = true,
		["universal script 📌"] = true,
		["script hub"] = true,
		["universal"] = true,
	}
	local function isUniversal(entry, gameName)
		if entry.universal == true or entry.isUniversal == true or entry.type == "universal" then
			return true
		end
		return type(gameName) == "string" and universalNames[gameName:lower()] == true
	end

	local function formatCount(value)
		local n = number(value)
		if n >= 1000000000 then
			return (string.format("%.1fB", n / 1000000000):gsub("%.0B", "B"))
		elseif n >= 1000000 then
			return (string.format("%.1fM", n / 1000000):gsub("%.0M", "M"))
		elseif n >= 1000 then
			return (string.format("%.1fk", n / 1000):gsub("%.0k", "k"))
		end
		return tostring(math.floor(n))
	end

	local function absoluteUrl(url, base)
		if type(url) ~= "string" or url == "" then
			return nil
		end
		if url:match("^https?://") then
			return url
		end
		return base .. (url:sub(1, 1) == "/" and url or "/" .. url)
	end

	local IMAGE_FOLDER = "WorldClient_Images"
	local IMAGE_MAX_BYTES = 2 * 1024 * 1024
	local IMAGE_RETRY_AFTER = 30
	local IMAGE_LOAD_TIMEOUT = 5
	local PNG_MAGIC = "\137PNG\13\10\26\10"
	local JPEG_MAGIC = "\255\216\255"

	local getCustomAsset = getcustomasset or getsynasset or (syn and syn.getcustomasset)
	local canLoadWebImages = type(getCustomAsset) == "function" and type(writefile) == "function"

	local rbxcdnSizes = {
		["/512/512/"] = "/150/150/",
		["/420/420/"] = "/150/150/",
		["/768/432/"] = "/480/270/",
	}

	local function normalizeImageUrl(url)
		if type(url) ~= "string" or not url:match("^https?://") then
			return nil
		end
		if url:find("rbxcdn.com", 1, true) then
			url = url:gsub("/Image/Webp/", "/Image/Png/")
			for from, to in pairs(rbxcdnSizes) do
				url = url:gsub(from, to, 1)
			end
			return url
		end
		local lowered = url:lower()
		if lowered:find("%.webp") or lowered:find("%.gif") or lowered:find("%.svg") then
			return nil
		end
		return url
	end

	local function imagePathFor(url)
		local hash = 2166136261
		for index = 1, #url do
			hash = bit32.bxor(hash, string.byte(url, index))
			hash = (hash * 16777619) % 4294967296
		end
		return ("%s/%08x.png"):format(IMAGE_FOLDER, hash)
	end

	local function extractIcoPng(data)
		if #data < 22 or data:sub(1, 4) ~= "\0\0\1\0" then
			return nil
		end
		local ok, result = pcall(function()
			local count = string.unpack("<I2", data, 5)
			for index = 0, count - 1 do
				local size, offset = string.unpack("<I4I4", data, 15 + index * 16)
				local blob = data:sub(offset + 1, offset + size)
				if blob:sub(1, 8) == PNG_MAGIC then
					return blob
				end
			end
			return nil
		end)
		return ok and result or nil
	end

	local imageAssets = {}
	local imageFailedAt = {}

	local function downloadImageAsset(url)
		local body = httpGet(url)

		if type(body) == "string" and #body > 0 and #body <= IMAGE_MAX_BYTES then
			if body:sub(1, 8) ~= PNG_MAGIC and body:sub(1, 3) ~= JPEG_MAGIC then
				body = extractIcoPng(body)
			end
		else
			body = nil
		end

		if not body then
			return nil
		end

		local asset
		pcall(function()
			if
				type(isfolder) == "function"
				and type(makefolder) == "function"
				and not isfolder(IMAGE_FOLDER)
			then
				makefolder(IMAGE_FOLDER)
			end
			local path = imagePathFor(url)
			writefile(path, body)
			asset = getCustomAsset(path)
		end)

		return (type(asset) == "string" and asset ~= "" and asset) or nil
	end

	local function resolveImageAsset(url)
		local cached = imageAssets[url]
		if cached then
			return cached
		end
		if not canLoadWebImages then
			return nil
		end
		local failedAt = imageFailedAt[url]
		if failedAt and os.clock() - failedAt < IMAGE_RETRY_AFTER then
			return nil
		end

		local ok, asset = pcall(downloadImageAsset, url)
		if ok and asset then
			imageAssets[url] = asset
			imageFailedAt[url] = nil
			return asset
		end

		imageFailedAt[url] = os.clock()
		return nil
	end

	local imageQueue = {}
	local imageWorkerRunning = false

	local function deliverImageAsset(target, apply, asset)
		task.spawn(function()
			if target.Parent then
				pcall(apply, asset)
			end
		end)
	end

	local function pumpImageQueue()
		if imageWorkerRunning then
			return
		end
		imageWorkerRunning = true
		task.spawn(function()
			while #imageQueue > 0 do
				local job = table.remove(imageQueue, 1)
				if job.Target.Parent then
					local asset = resolveImageAsset(job.Url)
					if asset then
						deliverImageAsset(job.Target, job.Apply, asset)
					end
				end
			end
			imageWorkerRunning = false
		end)
	end

	local function queueImageAsset(target, url, apply)
		if uiSettings.hubImages == false then
			return
		end
		local normalized = normalizeImageUrl(url)
		if not normalized or not canLoadWebImages then
			return
		end
		local cached = imageAssets[normalized]
		if cached then
			deliverImageAsset(target, apply, cached)
			return
		end
		for _, job in ipairs(imageQueue) do
			if job.Target == target then
				job.Url = normalized
				job.Apply = apply
				return
			end
		end
		table.insert(imageQueue, { Target = target, Url = normalized, Apply = apply })
		pumpImageQueue()
	end

	local function faviconUrl(domain)
		return ("https://www.google.com/s2/favicons?domain=%s&sz=64"):format(domain)
	end

	local function revealWhenLoaded(imageLabel, glyphLabel, image)
		imageLabel.Image = image
		local deadline = os.clock() + IMAGE_LOAD_TIMEOUT
		while not imageLabel.IsLoaded and imageLabel.Parent and os.clock() < deadline do
			task.wait(0.1)
		end
		if not imageLabel.Parent then
			return false
		end
		if imageLabel.IsLoaded then
			if glyphLabel then
				glyphLabel.Visible = false
			end
			return true
		end
		imageLabel.Image = ""
		return false
	end

	local function applyImageAsync(imageLabel, glyphLabel, url)
		queueImageAsset(imageLabel, url, function(asset)
			revealWhenLoaded(imageLabel, glyphLabel, asset)
		end)
	end

