			frameStartPos.X.Scale,
			math.clamp(targetPixelX, minX, maxX) - (frameStartPos.X.Scale * viewport.X),
			frameStartPos.Y.Scale,
			math.clamp(targetPixelY, minY, maxY) - (frameStartPos.Y.Scale * viewport.Y)
