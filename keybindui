local desktop = {
	Scale = 1,
	Size = UDim2.fromOffset(1040, 640),
	MinSize = Vector2.new(680, 400),
	UserSized = false,
	OnLayout = {},
}

do
local BASE_HEIGHT = 900
local FRACTION = Vector2.new(0.62, 0.68)
local MAX_SIZE = Vector2.new(1500, 940)
local MARGIN = 24

function desktop.viewport()
	local camera = workspace.CurrentCamera
	return (camera and camera.ViewportSize) or Vector2.new(1280, 720)
end

function desktop.px(n)
	return math.floor(n * desktop.Scale + 0.5)
end

function desktop.clampSize(width, height)
	local vp = desktop.viewport()
	local maxX = math.max(vp.X - MARGIN, 240)
	local maxY = math.max(vp.Y - MARGIN, 180)
	return Vector2.new(
		math.clamp(width, math.min(desktop.MinSize.X, maxX), maxX),
		math.clamp(height, math.min(desktop.MinSize.Y, maxY), maxY)
	)
end

function desktop.defaultSize()
	local vp = desktop.viewport()
	local size = desktop.clampSize(
		math.min(vp.X * FRACTION.X, MAX_SIZE.X * desktop.Scale),
		math.min(vp.Y * FRACTION.Y, MAX_SIZE.Y * desktop.Scale)
	)
	return UDim2.fromOffset(size.X, size.Y)
end

function desktop.clampPosition(position, absoluteSize, anchor)
	local vp = desktop.viewport()
	local pixelX = position.X.Scale * vp.X + position.X.Offset
	local pixelY = position.Y.Scale * vp.Y + position.Y.Offset
	local minX, maxX = absoluteSize.X * anchor.X, vp.X - absoluteSize.X * (1 - anchor.X)
	local minY, maxY = absoluteSize.Y * anchor.Y, vp.Y - absoluteSize.Y * (1 - anchor.Y)
	if minX > maxX then
		minX, maxX = vp.X * 0.5, vp.X * 0.5
	end
	if minY > maxY then
		minY, maxY = vp.Y * 0.5, vp.Y * 0.5
	end
	return UDim2.new(
		position.X.Scale,
		math.clamp(pixelX, minX, maxX) - position.X.Scale * vp.X,
		position.Y.Scale,
		math.clamp(pixelY, minY, maxY) - position.Y.Scale * vp.Y
	)
end

function desktop.refresh()
	local vp = desktop.viewport()
	desktop.Scale = math.clamp(vp.Y / BASE_HEIGHT, 0.8, 1.6)
	desktop.MinSize = Vector2.new(desktop.px(680), desktop.px(400))
	if desktop.UserSized then
		local size = desktop.clampSize(desktop.Size.X.Offset, desktop.Size.Y.Offset)
		desktop.Size = UDim2.fromOffset(size.X, size.Y)
	else
		desktop.Size = desktop.defaultSize()
	end
	for _, fn in ipairs(desktop.OnLayout) do
		pcall(fn)
	end
end

desktop.refresh()
