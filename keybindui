	function scriptHub.AddSaved(name, source)
		if type(source) ~= "string" or source:gsub("%s", "") == "" then
			return nil
		end
		local base = (type(name) == "string" and name or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if base == "" then
			base = "Script " .. tostring(#savedScripts + 1)
		end
		local unique = base
		local suffix = 2
		local function taken(candidate)
			for _, item in ipairs(savedScripts) do
				if item.Name == candidate then
					return true
				end
			end
			return false
		end
		while taken(unique) do
			unique = base .. " (" .. suffix .. ")"
			suffix += 1
		end
		table.insert(savedScripts, { Name = unique, Source = source })
		saveScriptsFile()
		if scriptsFrame.Visible then
			refreshScriptsList()
		end
		return unique
	end

	table.insert(
		connections,
		saveScriptBtn.MouseButton1Click:Connect(function()
			local source = inputBox.Text
			if source:gsub("%s", "") == "" then
				log("Nothing to save - the editor is empty.", "Warning")
				return
			end
			local name = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if name == "" then
				name = "Script " .. tostring(#savedScripts + 1)
			end
			for _, item in ipairs(savedScripts) do
				if item.Name == name then
					item.Source = source
					saveScriptsFile()
					refreshScriptsList()
					log("Updated saved script '" .. name .. "'.", "Info")
					return
				end
			end
			table.insert(savedScripts, { Name = name, Source = source })
			saveScriptsFile()
			refreshScriptsList()
			nameBox.Text = ""
			log("Saved script '" .. name .. "'.", "Info")
		end)
	)

