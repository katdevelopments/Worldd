	local ACTIONS_MIN_WIDTH = 210
	local TAGS_MIN_WIDTH = 150
	local PROVIDER_NAME_MIN_WIDTH = 130
	local META_MIN_WIDTH = 115
	local ROW_HEIGHTS = { Title = 19, Meta = 14, Tags = 16, Stats = 13, Actions = 26 }
	local ROW_GAP, CONTENT_INSET = 3, 40

	local function updateGrid()
		local columns = math.clamp(scriptHub.Columns or 4, 1, 4)
		local available = resultScroll.AbsoluteSize.X - resultScroll.ScrollBarThickness - 2
		if available <= 0 then
			return
		end

		local cellWidth = math.max(math.floor((available - CARD_GAP * (columns - 1)) / columns), 60)
		local showActions = cellWidth >= ACTIONS_MIN_WIDTH
		local showTags = cellWidth >= TAGS_MIN_WIDTH
		local showMeta = cellWidth >= META_MIN_WIDTH
		local showProviderName = cellWidth >= PROVIDER_NAME_MIN_WIDTH

		local stack, rows = ROW_HEIGHTS.Title + ROW_HEIGHTS.Stats, 2
		if showMeta then
			stack += ROW_HEIGHTS.Meta
			rows += 1
		end
		if showTags then
			stack += ROW_HEIGHTS.Tags
			rows += 1
		end
		if showActions then
			stack += ROW_HEIGHTS.Actions
			rows += 1
		end
		local minHeight = stack + ROW_GAP * (rows - 1) + CONTENT_INSET

		local cellHeight
		if columns == 1 then
			cellHeight = CARD_HEIGHT
		else
			local ratio = columns == 2 and 0.75 or 1.1
			cellHeight = math.clamp(math.floor(cellWidth * ratio), minHeight, 230)
		end
		resultLayout.CellSize = UDim2.new(0, cellWidth, 0, cellHeight)

		for _, entry in ipairs(hubEntries) do
			local card = entry.Card
			if card and card.Parent then
				local content = card:FindFirstChild("Content")
				if content then
					for name, visible in pairs({
						Actions = showActions,
						Tags = showTags,
						Meta = showMeta,
					}) do
						local row = content:FindFirstChild(name)
						if row then
							row.Visible = visible
						end
					end
				end
				local name = card:FindFirstChild("ProviderName")
				if name then
					name.Visible = showProviderName
				end
			end
		end
	end

