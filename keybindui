local function holderFor(obj)
	local holder = obj:FindFirstChild("WorldIconHolder")
	if not holder then
		holder = Instance.new("Frame")
		holder.Name = "WorldIconHolder"
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.Parent = obj
	end
	holder.ZIndex = obj.ZIndex + 1
	return holder
end

local function setPad(obj, extraLeft, extraRight)
	local pad = obj:FindFirstChildOfClass("UIPadding")
	if not pad then
		if extraLeft <= 0 and extraRight <= 0 then
			return
		end
		pad = Instance.new("UIPadding", obj)
		obj:SetAttribute("WorldIconBasePadLeft", 0)
		obj:SetAttribute("WorldIconBasePadRight", 0)
	end
	local baseLeft = obj:GetAttribute("WorldIconBasePadLeft")
	if baseLeft == nil then
		baseLeft = pad.PaddingLeft.Offset
		obj:SetAttribute("WorldIconBasePadLeft", baseLeft)
	end
	local baseRight = obj:GetAttribute("WorldIconBasePadRight")
	if baseRight == nil then
		baseRight = pad.PaddingRight.Offset
		obj:SetAttribute("WorldIconBasePadRight", baseRight)
	end
	pad.PaddingLeft = UDim.new(0, baseLeft + extraLeft)
	pad.PaddingRight = UDim.new(0, baseRight + extraRight)
end

local function centerHolder(rec)
	local holder = rec.Object:FindFirstChild("WorldIconHolder")
	if not holder or not holder.Visible then
		return
	end
	local px = rec.RenderPx or holder.AbsoluteSize.X
	holder.Position =
		UDim2.new(0.5, -(rec.Object.TextBounds.X * 0.5 + ICON_GAP + px * 0.5), 0.5, 0)
end

local function redraw(rec)
	local obj = rec.Object
	if not obj.Parent then
		return
	end
	local def = rec.Name and (registry[rec.Name] or registry.help) or nil
	local label = rec.Text or ""

	if def == nil or Icons.StyleIndex ~= ICON_STYLE_VECTOR then
		local existing = obj:FindFirstChild("WorldIconHolder")
		if existing then
			existing.Visible = false
		end
		setPad(obj, 0, 0)
		local emoji = def and def.Emoji or ""
		local text
		if rec.Mode == "icon" or label == "" then
			text = emoji
		elseif emoji == "" then
			text = label
		elseif rec.Mode == "placeholder" then
			text = emoji .. " " .. label
		elseif rec.Align == "right" then
			text = label .. "  " .. emoji
		else
			text = emoji .. "  " .. label
		end
		if rec.Mode == "placeholder" then
			obj.PlaceholderText = text
		else
			obj.Text = text
		end
		return
	end

	local holder = holderFor(obj)
	holder:ClearAllChildren()
	holder.Visible = true

	local px = rec.Px or math.max(10, math.floor((obj.TextSize or 14) * 1.15))
	rec.RenderPx = px
	holder.Size = UDim2.new(0, px, 0, px)

	if rec.Mode == "icon" then
		obj.Text = ""
		setPad(obj, 0, 0)
		holder.AnchorPoint = Vector2.new(0.5, 0.5)
		holder.Position = UDim2.new(0.5, 0, 0.5, 0)
	else
		local extra = px + ICON_GAP
		if rec.Mode == "placeholder" then
			obj.PlaceholderText = label
		else
			obj.Text = label
		end
		if rec.Align == "center" then
			setPad(obj, extra, 0)
			holder.AnchorPoint = Vector2.new(0.5, 0.5)
			centerHolder(rec)
		elseif rec.Align == "right" then
			setPad(obj, 0, extra)
			holder.AnchorPoint = Vector2.new(1, 0.5)
			holder.Position = UDim2.new(1, extra, 0.5, 0)
		else
			setPad(obj, extra, 0)
			holder.AnchorPoint = Vector2.new(0, 0.5)
			holder.Position = UDim2.new(0, -extra, 0.5, 0)
		end
	end

	local color = rec.Color or obj.TextColor3
	if def.Image then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = def.Image
		img.ImageColor3 = color
		img.ZIndex = holder.ZIndex
		img.Parent = holder
	else
		for _, shape in ipairs(def.Shapes) do
			renderShape(holder, shape, px, color)
		end
	end
	if obj.TextTransparency > 0 then
		restyle(rec)
	end
end

function restyle(rec)
	local holder = rec.Object:FindFirstChild("WorldIconHolder")
	if not holder or not holder.Visible then
		return
	end
	local color = rec.Color or rec.Object.TextColor3
	local alpha = rec.Object.TextTransparency
	for _, part in ipairs(holder:GetChildren()) do
		if part:IsA("ImageLabel") then
			part.ImageColor3 = color
			part.ImageTransparency = alpha
		elseif part:IsA("Frame") then
			local stroke = part:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = color
				stroke.Transparency = alpha
			else
				part.BackgroundColor3 = color
				part.BackgroundTransparency = alpha
			end
		end
	end
end

Icons = {
	Styles = iconStyles,
	StyleIndex = 1,
	Registry = registry,
}

for i, style in ipairs(iconStyles) do
	if style.Key == uiSettings.iconStyle then
		Icons.StyleIndex = i
	end
end

function Icons.bind(obj, name, opts)
	opts = opts or {}
	local rec = {
		Object = obj,
		Name = name,
		Mode = opts.Mode or "icon",
		Align = opts.Align or "left",
		Px = opts.Px,
		Text = opts.Text,
		Color = opts.Color,
	}
	bound[obj] = rec

	local ownConnections = {
		obj:GetPropertyChangedSignal("TextColor3"):Connect(function()
			restyle(rec)
		end),
		obj:GetPropertyChangedSignal("TextTransparency"):Connect(function()
			restyle(rec)
		end),
		obj:GetPropertyChangedSignal("ZIndex"):Connect(function()
			local holder = obj:FindFirstChild("WorldIconHolder")
			if holder then
				holder.ZIndex = obj.ZIndex + 1
				for _, part in ipairs(holder:GetChildren()) do
					part.ZIndex = holder.ZIndex
				end
			end
		end),
	}
	if rec.Mode ~= "icon" and rec.Align == "center" then
		table.insert(ownConnections, obj:GetPropertyChangedSignal("TextBounds"):Connect(function()
			centerHolder(rec)
		end))
	end
	local cleanup
	cleanup = obj.Destroying:Connect(function()
		bound[obj] = nil
		for _, conn in ipairs(ownConnections) do
			conn:Disconnect()
		end
		cleanup:Disconnect()
	end)

	redraw(rec)
	return obj
end

function Icons.setText(obj, text)
	local rec = bound[obj]
	if rec then
		rec.Text = text
		redraw(rec)
	end
end

function Icons.setName(obj, name)
	local rec = bound[obj]
	if rec and rec.Name ~= name then
		rec.Name = name
		redraw(rec)
	end
end

function Icons.getName(obj)
	local rec = bound[obj]
	return rec and rec.Name or nil
end

function Icons.prefix(name)
	if Icons.StyleIndex == ICON_STYLE_VECTOR then
		return ""
	end
	return Icons.glyph(name) .. " "
end

function Icons.glyph(name)
	local def = registry[name]
	return def and def.Emoji or ""
end

function Icons.refreshAll()
	for obj, rec in pairs(bound) do
		if obj.Parent then
			redraw(rec)
		else
			bound[obj] = nil
		end
	end
end
end

