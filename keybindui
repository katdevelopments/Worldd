local httpGet
do
local ticketNext = 0
local ticketServing = 0
local QUEUE_TIMEOUT = 25
local requesterBroken = false

local function executorRequest(url)
	local requester = (syn and syn.request)
		or (http and http.request)
		or http_request
		or (fluxus and fluxus.request)
		or request
	if not requester or requesterBroken then
		return nil
	end
	local ok, res = pcall(requester, { Url = url, Method = "GET" })
	if not ok then
		if type(res) == "string" and res:find("non%-suspended") then
			requesterBroken = true
		end
		return nil
	end
	if type(res) == "table" and (res.StatusCode == 200 or res.Success) and type(res.Body) == "string" then
		return res.Body
	end
	return nil
end

function httpGet(url)
	ticketNext += 1
	local ticket = ticketNext
	local deadline = os.clock() + QUEUE_TIMEOUT
	while ticketServing + 1 ~= ticket and os.clock() < deadline do
		task.wait()
	end

	local ok, body = pcall(executorRequest, url)
	if not ok then
		body = nil
	end
	if body == nil then
		local fetched
		ok, fetched = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(fetched) == "string" then
			body = fetched
		end
	end

	if ticketServing < ticket then
		ticketServing = ticket
	end
	return body
end
end

