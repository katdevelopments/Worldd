		glyph.ZIndex = zIndex
		Icons.bind(glyph, provider and provider.Glyph or "help", { Mode = "icon", Px = math.floor(size * 0.9) })

		if provider then
			local assetId = provider.Icon
			if type(assetId) ~= "string" or assetId == "" then
				applyImageAsync(badge, glyph, provider.IconUrl)
			else
				task.spawn(function()
					if revealWhenLoaded(badge, glyph, assetId) then
						return
