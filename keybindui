	local function paintThumbnail(imageLabel, glyphLabel, entry)
		local instant = thumbnailFor(entry)
		imageLabel.Image = ""
		glyphLabel.Visible = true
		if instant == "" then
			applyImageAsync(imageLabel, glyphLabel, entry.ImageUrl)
			return
		end
		task.spawn(function()
			if revealWhenLoaded(imageLabel, glyphLabel, instant) then
				return
			end
			if imageLabel.Parent then
				applyImageAsync(imageLabel, glyphLabel, entry.ImageUrl)
			end
		end)
	end

