local function rowHaystack(row)
	local parts = row:GetAttribute("SearchKey") or ""
	if row:IsA("TextButton") or row:IsA("TextLabel") then
		parts = parts .. " " .. row.Text
	else
		local label = row:FindFirstChildWhichIsA("TextLabel")
		if label then
			parts = parts .. " " .. label.Text
		end
	end
	return parts:lower()
end

function settingsFilter()
	local anyVisible = false
	for _, row in ipairs(settingsScroll:GetChildren()) do
		if row:IsA("GuiObject") then
			local category = row:GetAttribute("Category")
			if category == nil then
				row.Visible = true
			elseif row:GetAttribute("IsHeader") then
				row.Visible = searchQuery == ""
					and (activeCategory == "all" or category == activeCategory)
			else
				local matchesCategory = (activeCategory == "all") or (category == activeCategory)
				local matchesSearch = searchQuery == ""
					or rowHaystack(row):find(searchQuery, 1, true) ~= nil
				row.Visible = matchesCategory and matchesSearch
				if row.Visible then
					anyVisible = true
				end
			end
		end
	end
	settingsScroll.CanvasPosition = Vector2.new(0, 0)
	return anyVisible
end

