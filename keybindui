local setClientVisible, toggleClient
do
local fadeObjects, fadeProps, fadeBases = {}, {}, {}
local fadeCount = 0
local FADE_TIME = 0.28

local function addFadeTarget(obj, prop)
	fadeCount += 1
	fadeObjects[fadeCount] = obj
	fadeProps[fadeCount] = prop
	fadeBases[fadeCount] = obj[prop]
end

local function collectFadeTargets(parent)
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("GuiObject") then
			if child.Visible then
				addFadeTarget(child, "BackgroundTransparency")
				if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
					addFadeTarget(child, "TextTransparency")
					addFadeTarget(child, "TextStrokeTransparency")
				elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
					addFadeTarget(child, "ImageTransparency")
				end
				if child:IsA("ScrollingFrame") then
					addFadeTarget(child, "ScrollBarImageTransparency")
				end
				collectFadeTargets(child)
			end
		elseif child:IsA("UIStroke") then
			addFadeTarget(child, "Transparency")
		end
	end
end

local function snapshotFade()
	fadeCount = 0
	table.clear(fadeObjects)
	table.clear(fadeProps)
	table.clear(fadeBases)
	collectFadeTargets(uiRoot)
	collectFadeTargets(blurLayer)
end

local function applyFade(alpha)
	for i = 1, fadeCount do
		local base = fadeBases[i]
		fadeObjects[i][fadeProps[i]] = base + (1 - base) * alpha
	end
end

local function restoreFade()
	for i = 1, fadeCount do
		fadeObjects[i][fadeProps[i]] = fadeBases[i]
	end
	fadeCount = 0
	table.clear(fadeObjects)
	table.clear(fadeProps)
	table.clear(fadeBases)
end

local fading = false
local fadeShowing = false
local fadeFrom, fadeTo, fadeElapsed = 0, 0, 0
local pendingTutorial = false

local function openPendingTutorial()
	if pendingTutorial and not tutorialShown and not tutorialCompleted then
		pendingTutorial = false
		showTutorial()
	end
end

table.insert(
	connections,
	RunService.RenderStepped:Connect(function(dt)
		if not fading then
			return
		end
		fadeElapsed += dt
		local t = math.clamp(fadeElapsed / FADE_TIME, 0, 1)
		local eased = TweenService:GetValue(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		applyFade(fadeFrom + (fadeTo - fadeFrom) * eased)
		if t >= 1 then
			fading = false
			restoreFade()
			uiRoot.Visible = fadeShowing
			blurLayer.Visible = fadeShowing
			if fadeShowing then
				if uiSettings.glow then
					startGlow()
				end
				openPendingTutorial()
			end
		end
	end)
)

function setClientVisible(visible, instant)
	isHidden = not visible

	blur.Enabled = visible and uiSettings.blur == true
	inputSink.Active = visible

	if visible then
		controls:Disable()
	else
		controls:Enable()
		if inputBox:IsFocused() then
			inputBox:ReleaseFocus()
		end
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default

	fading = false
	restoreFade()

	if visible and not tutorialShown and not tutorialCompleted then
		pendingTutorial = true
	end

	if instant then
		uiRoot.Visible = visible
		blurLayer.Visible = visible
		if visible then
			openPendingTutorial()
		end
	else
		for _, key in ipairs({ "glowTransparency", "glowThickness", "strokeSpin" }) do
			if activeTweens[key] then
				activeTweens[key]:Cancel()
				activeTweens[key] = nil
			end
		end
		blurStroke.Transparency = 0.2
		blurStroke.Thickness = 2

		uiRoot.Visible = true
		blurLayer.Visible = true
		snapshotFade()

		fadeShowing = visible
		fadeFrom = visible and 1 or 0
		fadeTo = visible and 0 or 1
		fadeElapsed = 0
		fading = true
		applyFade(fadeFrom)
	end
end

function toggleClient()
	setClientVisible(isHidden)
end
end

