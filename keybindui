	end
	if type(data.editorLineNumbers) == "boolean" then
		uiSettings.editorLineNumbers = data.editorLineNumbers
	end
	if type(data.consoleLineNumbers) == "boolean" then
		uiSettings.consoleLineNumbers = data.consoleLineNumbers
	end
	if type(data.iconStyle) == "string" then
		uiSettings.iconStyle = data.iconStyle
	end
	if type(data.mobileMode) == "boolean" then
		uiSettings.mobileMode = data.mobileMode
	end
	if type(data.reduceMotion) == "boolean" then
		uiSettings.reduceMotion = data.reduceMotion
	end
	if type(data.hubImages) == "boolean" then
		uiSettings.hubImages = data.hubImages
	end
	if type(data.maxLogs) == "number" then
		uiSettings.maxLogs = math.clamp(math.floor(data.maxLogs), 25, 500)
	end
	if type(data.logTimestamps) == "boolean" then
		uiSettings.logTimestamps = data.logTimestamps
	end
	if type(data.syntaxHighlight) == "boolean" then
		uiSettings.syntaxHighlight = data.syntaxHighlight
	end
	if type(data.editorSplit) == "boolean" then
		uiSettings.editorSplit = data.editorSplit
	end
	if type(data.editorHeight) == "number" then
		uiSettings.editorHeight = data.editorHeight
	end
	if type(data.tutorialCompleted) == "boolean" then
		tutorialCompleted = data.tutorialCompleted
	end
	if type(data.scriptHubAccepted) == "boolean" then
		scriptHub.Accepted = data.scriptHubAccepted
	end
	if type(data.scriptHubColumns) == "number" then
		scriptHub.Columns = math.clamp(math.floor(data.scriptHubColumns), 1, 4)
	end
	if type(data.scriptHubProviders) == "table" then
		for key in pairs(scriptHub.Providers) do
			if type(data.scriptHubProviders[key]) == "boolean" then
				scriptHub.Providers[key] = data.scriptHubProviders[key]
			end
		end
	end
	if type(data.customTheme) == "table" then
		for key, v in pairs(data.customTheme) do
			if
				customThemeColors[key]
				and type(v) == "table"
				and type(v.r) == "number"
				and type(v.g) == "number"
