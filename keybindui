		ring.Size = UDim2.new(0, 132, 0, 132)
		ring.BackgroundTransparency = 1
		ring.ZIndex = 41
		Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
		local ringStroke = Instance.new("UIStroke", ring)
		ringStroke.Color = CONFIG.Colors.PrimaryAccent
		ringStroke.Thickness = 2
		ringStroke.Transparency = 1
		local ringGradient = Instance.new("UIGradient", ringStroke)
		ringGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, CONFIG.Colors.PrimaryAccent),
			ColorSequenceKeypoint.new(0.5, CONFIG.Colors.SecondaryAccent),
			ColorSequenceKeypoint.new(1, CONFIG.Colors.PrimaryAccent),
		})
		local ringScale = Instance.new("UIScale", ring)
		ringScale.Scale = 0.4

		local introIcon = Instance.new("ImageLabel", screenGui)
		introIcon.Name = "IntroIcon"
		introIcon.AnchorPoint = Vector2.new(0.5, 0.5)
		introIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
		introIcon.Size = UDim2.new(0, 96, 0, 96)
		introIcon.BackgroundTransparency = 1
		introIcon.Image = CONFIG.IconID
		introIcon.ZIndex = 42
		local introScale = Instance.new("UIScale", introIcon)
		introScale.Scale = 0

		local introPieces = { overlay, ring, introIcon }

		local function finish()
			if finished then
				return
			end
			finished = true
			for _, piece in ipairs(introPieces) do
				if piece.Parent then
					piece:Destroy()
				end
			end
			setClientVisible(true)
		end

		table.insert(
			connections,
			overlay.MouseButton1Click:Connect(function()
				skipped = true
			end)
		)

		TweenService:Create(overlay, TweenInfo.new(0.4), { BackgroundTransparency = 0.35 }):Play()
		TweenService
			:Create(introScale, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()
		TweenService
			:Create(ringScale, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()
		TweenService:Create(ringStroke, TweenInfo.new(0.6), { Transparency = 0.25 }):Play()
		local orbit = TweenService:Create(
			ringGradient,
			TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
			{ Rotation = 360 }
		)
		orbit:Play()
		local sway = TweenService:Create(
			introIcon,
			TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Rotation = 8 }
		)
		sway:Play()
		createClickParticles(introIcon, CONFIG.Colors.SecondaryAccent)

		task.wait(0.55)

		local hold = 0
		while hold < 1.1 and not skipped do
			hold += task.wait()
		end

		if skipped then
			orbit:Cancel()
			sway:Cancel()
			finish()
			return
		end

		sway:Cancel()
		TweenService:Create(introIcon, TweenInfo.new(0.3), { Rotation = 0 }):Play()
		TweenService:Create(ringStroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		TweenService
			:Create(ringScale, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.7 })
			:Play()
		TweenService:Create(overlay, TweenInfo.new(0.45), { BackgroundTransparency = 1 }):Play()
		TweenService
			:Create(introScale, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.45 })
			:Play()
		TweenService:Create(introIcon, TweenInfo.new(0.4), { ImageTransparency = 1 }):Play()

		local elapsed = 0
		while elapsed < 0.32 and not skipped do
			elapsed += task.wait()
		end

		orbit:Cancel()
		finish()
	end)
end

screenGui.Destroying:Connect(function()
	if blur and blur.Parent then
		blur:Destroy()
	end
	if blurGui and blurGui.Parent then
		blurGui:Destroy()
	end
	for _, tween in pairs(activeTweens) do
		tween:Cancel()
	end
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	controls:Enable()
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
end)

refreshLogs()
setClientVisible(false, true)
if uiSettings.glow then
	startGlow()
end
activeTweens.titleShimmer:Play()
updateInputControlsVisibility()
onInsetsChanged()
if languages[currentLanguageIndex].Code ~= "en" then
	localizeUI()
end

if uiSettings.fpsBooster then
	applyFpsBooster(true)
end
if uiSettings.antiAfk then
	applyAntiAfk(true)
end

playIntro()

task.delay(1, function()
	if runAutoExecScripts then
		runAutoExecScripts()
	end
end)

return true
