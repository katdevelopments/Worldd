					if badge.Parent then
						applyImageAsync(badge, glyph, provider.IconUrl)
					end
				end)
			end
		end
		return badge
	end

	local POPULAR_VIEWS = 500000
	local GOOD_REVIEW_VIEWS = 100000

	local function isUndefinedEntry(entry)
		return not entry.Verified and not entry.Universal
	end

	local function tagsFor(entry)
		local tags = {}
		if entry.Views > POPULAR_VIEWS then
			table.insert(tags, { Icon = "flame", Label = "Popular" })
		end
		if entry.Views > GOOD_REVIEW_VIEWS then
			table.insert(tags, { Icon = "thumbsUp", Label = "Good reviews" })
		else
			table.insert(tags, { Icon = "thumbsDown", Label = "Bad reviews", Dark = true })
		end
		if entry.Verified then
			table.insert(tags, { Icon = "shield", Label = "Verified" })
		end
		if entry.Universal then
			table.insert(tags, { Icon = "globe", Label = "Universal" })
		end
		if isUndefinedEntry(entry) then
			table.insert(tags, { Icon = "help", Label = "Undefined" })
		end
		if entry.KeySystem then
			table.insert(tags, { Icon = "key", Label = "Key", Dark = true })
		end
		if entry.Patched then
			table.insert(tags, { Icon = "blocked", Label = "Patched", Dark = true })
		end
		if entry.Mobile then
			table.insert(tags, { Icon = "phone", Label = "Mobile" })
		end
		return tags
	end

	local function resolveSource(entry)
		if type(entry.Source) == "string" and entry.Source ~= "" then
			return entry.Source
		end
		if type(entry.RawUrl) == "string" and entry.RawUrl ~= "" then
			local body = httpGet(entry.RawUrl)
			if type(body) == "string" and body ~= "" then
				return body
			end
		end
		local provider = hubProviderByKey[entry.Provider]
		if provider and provider.DetailUrl and provider.DetailParse then
			local data = hubJson(provider.DetailUrl(entry))
			if data then
				local source = provider.DetailParse(data)
				if type(source) == "string" and source ~= "" then
					return source
				end
			end
		end
		return nil
	end

	local function closeDetail()
		if not detailFrame.Visible then
			return
		end
		hubDetailToken += 1
		TweenService:Create(detailOverlay, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
		local tween = TweenService:Create(
			detailScale,
			TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In),
			{ Scale = 0 }
		)
		tween:Play()
		tween.Completed:Wait()
		detailOverlay.Visible = false
		detailFrame.Visible = false
		hubDetailEntry = nil
	end

	local function openDetail(entry)
		hubDetailEntry = entry
		hubDetailToken += 1
		local token = hubDetailToken

		detailTitle.Text = entry.Title
		local metaParts = {
			entry.ProviderName,
			entry.Game,
			Icons.prefix("user") .. entry.Creator,
			Icons.prefix("eye") .. formatCount(entry.Views),
		}
		for _, tag in ipairs(tagsFor(entry)) do
			table.insert(metaParts, Icons.prefix(tag.Icon) .. tag.Label)
		end
		detailMeta.Text = table.concat(metaParts, "  •  ")

		paintThumbnail(detailThumb, detailThumbGlyph, entry)

		codeLabel.Text = tr("Loading script source...")
		codeScroll.CanvasPosition = Vector2.new(0, 0)

		detailOverlay.Visible = true
		detailFrame.Visible = true
		TweenService:Create(detailOverlay, TweenInfo.new(0.25), { BackgroundTransparency = 0.5 }):Play()
		detailScale.Scale = 0
		TweenService
			:Create(detailScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()

		task.spawn(function()
			local source = resolveSource(entry)
			if token ~= hubDetailToken then
				return
			end
			if source then
				entry.Source = source
				if #source > HUB_PREVIEW_LIMIT then
					codeLabel.Text = source:sub(1, HUB_PREVIEW_LIMIT)
						.. "\n\n-- "
						.. tr("Preview truncated - Copy, Editor, Save and Run still use the full script.")
				else
					codeLabel.Text = source
				end
			else
				codeLabel.Text = tr("Failed to load this script's source.")
			end
		end)
	end

