local inputBox
local editorGutterPad

local updateEditorLines
local syncEditorGutter
do
local EDITOR_IDLE = 0.5
local lastLineCount = -1
local lastGutterWidth = -1
local typingUntil = 0

local function applyGutterVisibility()
	editorLineGutter.Visible = uiSettings.editorLineNumbers == true
		and inputBox ~= nil
		and inputBox.Text ~= ""
		and os.clock() >= typingUntil
end

local function noteTyping()
	typingUntil = os.clock() + EDITOR_IDLE
	editorLineGutter.Visible = false
	task.delay(EDITOR_IDLE, applyGutterVisibility)
end

function updateEditorLines()
	if not inputBox then
		return
	end
	noteTyping()
	local lines = 1
	for _ in string.gmatch(inputBox.Text, "\n") do
		lines += 1
	end
	local width = math.max(24, 10 + #tostring(lines) * math.ceil(CONFIG.TextSize * 0.6))
	if lines == lastLineCount and width == lastGutterWidth then
		return
	end
	lastLineCount = lines
	local numbers = table.create(lines)
	for i = 1, lines do
		numbers[i] = tostring(i)
	end
	editorLineGutter.Text = table.concat(numbers, "\n")
	if width ~= lastGutterWidth then
		lastGutterWidth = width
		editorLineGutter.Size = UDim2.new(0, width, 0, 0)
		if editorGutterPad and uiSettings.editorLineNumbers == true then
			editorGutterPad(width + 8)
		end
	end
end

function syncEditorGutter()
	if not editorGutterPad then
		return
	end
	if uiSettings.editorLineNumbers == true then
		lastGutterWidth = -1
		updateEditorLines()
		editorGutterPad(editorLineGutter.Size.X.Offset + 8)
	else
		editorGutterPad(10)
	end
	typingUntil = 0
	applyGutterVisibility()
end
end

