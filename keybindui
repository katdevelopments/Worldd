local editorTabs, activeTabIndex, switchToTab, newTab, addTab

do
	local TABS_FILE = "WorldClient_Tabs.json"
	editorTabs = {}
	activeTabIndex = 1
	local switchingTabs = false
	local nextTabId = 1
	local tabButtons = {}
	local saveTabs
	local refreshTabBar

	function newTab(name, content, pinned)
		local tab = {
			id = nextTabId,
			name = name or ("Script " .. nextTabId),
			content = content or "",
			pinned = pinned or false,
		}
		nextTabId += 1
		return tab
	end

	do
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(TABS_FILE))
		end)
		if ok and type(data) == "table" and type(data.tabs) == "table" then
			for _, item in ipairs(data.tabs) do
				if type(item) == "table" and type(item.c) == "string" then
					table.insert(editorTabs, newTab(type(item.n) == "string" and item.n or nil, item.c, item.p == true))
				end
			end
			if type(data.active) == "number" and editorTabs[data.active] then
				activeTabIndex = data.active
			end
		end
	end
	if #editorTabs == 0 then
		table.insert(editorTabs, newTab("Script 1", "", false))
		activeTabIndex = 1
	end

	function saveTabs()
		pcall(function()
			local out = {}
			for _, tab in ipairs(editorTabs) do
				table.insert(out, { n = tab.name, c = tab.content, p = tab.pinned })
			end
			writefile(TABS_FILE, HttpService:JSONEncode({ active = activeTabIndex, tabs = out }))
		end)
	end
