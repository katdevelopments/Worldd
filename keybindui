local function join(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, item in ipairs(list) do
			table.insert(out, item)
		end
	end
	return out
end

local function poly(pts, w, close)
	local out = {}
	for i = 1, #pts - 1 do
		table.insert(out, ln(pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], w))
	end
	if close and #pts > 2 then
		table.insert(out, ln(pts[#pts][1], pts[#pts][2], pts[1][1], pts[1][2], w))
	end
	return out
end

local function starPoly(cx, cy, outer, inner, count, w)
	local pts = {}
	for i = 0, count * 2 - 1 do
		local ang = math.rad(-90 + i * (180 / count))
		local rad = (i % 2 == 0) and outer or inner
		table.insert(pts, { cx + math.cos(ang) * rad, cy + math.sin(ang) * rad })
	end
	return poly(pts, w, true)
end

