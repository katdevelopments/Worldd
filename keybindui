local function addPart(holder, color)
	local part = Instance.new("Frame")
	part.BorderSizePixel = 0
	part.BackgroundColor3 = color
	part.ZIndex = holder.ZIndex
	part.Parent = holder
	return part
end

local function strokePart(holder, color, thickness)
	local part = Instance.new("Frame")
	part.BorderSizePixel = 0
	part.BackgroundTransparency = 1
	part.ZIndex = holder.ZIndex
	local stroke = Instance.new("UIStroke", part)
	stroke.Color = color
	stroke.Thickness = thickness
	part.Parent = holder
	return part
end

local function renderShape(holder, shape, px, color)
	local kind = shape[1]
	if kind == "l" then
		local x1, y1, x2, y2, w = shape[2], shape[3], shape[4], shape[5], shape[6]
		local dx, dy = (x2 - x1) * px, (y2 - y1) * px
		local part = addPart(holder, color)
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Position = UDim2.new(0, (x1 + x2) * 0.5 * px, 0, (y1 + y2) * 0.5 * px)
		local thick = math.max(1, w * px)
		part.Size = UDim2.new(0, math.max(math.sqrt(dx * dx + dy * dy), thick), 0, thick)
		part.Rotation = math.deg(math.atan2(dy, dx))
		Instance.new("UICorner", part).CornerRadius = UDim.new(1, 0)
	elseif kind == "c" then
		local part = addPart(holder, color)
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Position = UDim2.new(0, shape[2] * px, 0, shape[3] * px)
		part.Size = UDim2.new(0, math.max(1, shape[4] * px), 0, math.max(1, shape[4] * px))
		Instance.new("UICorner", part).CornerRadius = UDim.new(1, 0)
	elseif kind == "o" then
		local part = strokePart(holder, color, math.max(1, shape[5] * px))
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Position = UDim2.new(0, shape[2] * px, 0, shape[3] * px)
		part.Size = UDim2.new(0, shape[4] * px, 0, shape[4] * px)
		Instance.new("UICorner", part).CornerRadius = UDim.new(1, 0)
	elseif kind == "b" then
		local x, y, w, h, t, r = shape[2], shape[3], shape[4], shape[5], shape[6], shape[7]
		local part = strokePart(holder, color, math.max(1, t * px))
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Position = UDim2.new(0, x * px, 0, y * px)
		part.Size = UDim2.new(0, w * px, 0, h * px)
		Instance.new("UICorner", part).CornerRadius = UDim.new(0, math.min(w, h) * px * 0.5 * r)
	elseif kind == "t" then
		local x, y, w, h, dir = shape[2], shape[3], shape[4], shape[5], shape[6] or "right"
		local slices = 14
		local bleed = 0.7 / math.max(px, 1)
		for i = 0, slices - 1 do
			local f = (i + 0.5) / slices
			local part = addPart(holder, color)
			part.AnchorPoint = Vector2.new(0.5, 0.5)
			local sw, sh, cx, cy
			if dir == "right" then
				sw, sh = w / slices + bleed, h * (1 - f)
				cx, cy = x - w * 0.5 + f * w, y
			elseif dir == "left" then
				sw, sh = w / slices + bleed, h * (1 - f)
				cx, cy = x + w * 0.5 - f * w, y
			elseif dir == "up" then
				sw, sh = w * (1 - f), h / slices + bleed
				cx, cy = x, y + h * 0.5 - f * h
			else
				sw, sh = w * (1 - f), h / slices + bleed
				cx, cy = x, y - h * 0.5 + f * h
			end
			part.Position = UDim2.new(0, cx * px, 0, cy * px)
			part.Size = UDim2.new(0, math.max(1, sw * px), 0, math.max(1, sh * px))
		end
	elseif kind == "a" then
		local x, y, r, a0, a1, w = shape[2], shape[3], shape[4], shape[5], shape[6], shape[7]
		local steps = math.max(6, math.ceil(math.abs(a1 - a0) / 9))
		local d = math.max(1, w * px)
		for i = 0, steps do
			local ang = math.rad(a0 + (a1 - a0) * (i / steps))
			local part = addPart(holder, color)
			part.AnchorPoint = Vector2.new(0.5, 0.5)
			part.Position = UDim2.new(0, (x + math.cos(ang) * r) * px, 0, (y + math.sin(ang) * r) * px)
			part.Size = UDim2.new(0, d, 0, d)
			Instance.new("UICorner", part).CornerRadius = UDim.new(1, 0)
		end
	end
end

