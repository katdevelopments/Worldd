do
local widestDigits = 0

local function entryInset()
	local inset = 60
	if uiSettings.consoleLineNumbers == true then
		inset += consoleGutterWidth + 4
	end
	if uiSettings.logTimestamps == true then
		inset += consoleStampWidth + 4
	end
	return -inset
end

function refreshConsoleColumns()
	local showLines = uiSettings.consoleLineNumbers == true
	local showStamps = uiSettings.logTimestamps == true
	consoleStampWidth = math.ceil(CONFIG.TextSize * 3.7)
	templateLineNumber.Visible = showLines
	templateLineNumber.Size = UDim2.new(0, consoleGutterWidth, 0, 0)
	templateStamp.Visible = showStamps
	templateStamp.Size = UDim2.new(0, consoleStampWidth, 0, 0)
	templateEntry.Size = UDim2.new(1, entryInset(), 0, 0)
	for _, child in ipairs(logContainer:GetChildren()) do
		if child:IsA("Frame") and child.Name == "LogFrame" then
			local ln = child:FindFirstChild("LineNumber")
			local stamp = child:FindFirstChild("Timestamp")
			local entry = child:FindFirstChild("LogEntry")
			if ln then
				ln.Visible = showLines
				ln.Size = UDim2.new(0, consoleGutterWidth, 0, 0)
			end
			if stamp then
				stamp.Visible = showStamps
				stamp.Size = UDim2.new(0, consoleStampWidth, 0, 0)
			end
			if entry then
				entry.Size = UDim2.new(1, entryInset(), 0, 0)
			end
		end
	end
end

function syncConsoleGutter(numberText)
	local digits = #numberText
	if digits <= widestDigits then
		return
	end
	widestDigits = digits
	consoleGutterWidth = math.max(26, 6 + digits * math.ceil(CONFIG.TextSize * 0.6))
	refreshConsoleColumns()
end
end

